  .neu-stat-wells-grid {
    grid-template-columns: repeat(2, 1fr) !important;
  }
}

@media (max-width: 480px) {
  #view-dashboard .stats-grid,
  .neu-stat-wells-grid {
    grid-template-columns: 1fr !important;
  }
}

/* --------------------------------------------------------------------------
   4. THẺ CARD THANH THOÁT & SPOTLIGHT TÍM HỒNG PASTEL (ORCHID ROSE SPOTLIGHT)
   -------------------------------------------------------------------------- */
.stat-card,
.study-mode-card,
.deck-card,
.subject-group,
.quiz-card,
.bank-card-item,
.neu-stat-well {
  background: var(--bg-card) !important;
  border: 1px solid var(--glass-border) !important;
  box-shadow: var(--shadow-sm) !important;
  border-radius: var(--radius-card) !important;
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease !important;
}

@media (hover: hover) and (pointer: fine) {
  .stat-card::before,
  .study-mode-card::before,
  .deck-card::before,
  .bank-card-item::before,
  .neu-stat-well::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      360px circle at var(--mx, 50%) var(--my, 50%),
      rgba(244, 114, 182, 0.13) 0%,
      rgba(192, 132, 252, 0.06) 45%,
      transparent 78%
    ) !important;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 0;
  }

  .stat-card:hover::before,
  .study-mode-card:hover::before,
  .deck-card:hover::before,
  .bank-card-item:hover::before,
  .neu-stat-well:hover::before {
    opacity: 1 !important;
  }

  .stat-card:hover,
  .study-mode-card:hover,
  .deck-card:hover,
  .bank-card-item:hover,
  .neu-stat-well:hover {
    transform: translateY(-2px) !important;
    border-color: rgba(244, 114, 182, 0.38) !important;
    box-shadow: var(--card-hover-glow) !important;
  }
}

/* Stat card interior layout */
.stat-card {
  padding: 16px 20px !important;
  display: flex !important;
  align-items: center !important;
  gap: 14px !important;
}

.stat-icon-wrap {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  flex-shrink: 0;
  background: rgba(168, 85, 247, 0.12);
  border: 1px solid rgba(192, 132, 252, 0.2);
}

.stat-icon-wrap.amber {
  background: rgba(251, 191, 36, 0.12);
  border-color: rgba(251, 191, 36, 0.25);
}
.stat-icon-wrap.purple {
  background: rgba(168, 85, 247, 0.12);
  border-color: rgba(168, 85, 247, 0.25);
}
.stat-icon-wrap.green {
  background: rgba(52, 211, 153, 0.12);
  border-color: rgba(52, 211, 153, 0.25);
}
.stat-icon-wrap.indigo {
  background: rgba(129, 140, 248, 0.12);
  border-color: rgba(129, 140, 248, 0.25);
}

.stat-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  position: relative;
  z-index: 1;
}

.stat-info .stat-num {
  font-size: 1.45rem;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.15;
  font-family: var(--font-heading);
}

.stat-info .stat-label {
  font-size: 0.78rem;
  color: var(--text-muted);
  font-weight: 500;
}

/* Thanh Độ Bền Lưu Giữ SM-2 nằm gọn ngang dưới 4 ô chỉ số */
.sm2-status-banner,
.neu-retention-strip {
  background: var(--bg-card) !important;
  border: 1px solid var(--glass-border) !important;
  border-radius: var(--radius-lg) !important;
  padding: 14px 20px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 20px !important;
  flex-wrap: wrap !important;
  box-shadow: var(--shadow-xs) !important;
}

.sm2-retention-track,
.retention-track-well {
  background: var(--bg-well) !important;
  border-radius: 9999px !important;
  height: 8px !important;
  width: 100% !important;
  overflow: hidden !important;
  border: 1px solid rgba(192, 132, 252, 0.15) !important;
}

.sm2-retention-fill,
.retention-fill-thermal {
  height: 100% !important;
  border-radius: 9999px !important;
  background: linear-gradient(90deg, #7c3aed 0%, #ec4899 50%, #f472b6 100%) !important;
  box-shadow: 0 0 10px rgba(244, 114, 182, 0.4) !important;
  transition: width 0.7s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

/* Mini 7-day Heatmap */
.mini-heatmap-days {
  display: flex;
  align-items: center;
  gap: 6px;
}

.mini-day-dot {
  width: 16px;
  height: 16px;
  border-radius: 4px;
  background: rgba(30, 20, 54, 0.85);
  border: 1px solid rgba(192, 132, 252, 0.22);
