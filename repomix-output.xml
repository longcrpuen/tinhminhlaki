    const width = (r.width + 4) + 'px', height = (r.height + 4) + 'px';
    const showTagTooltip = shouldShowHighlightTagTooltip();

    const hiWasHidden = highlightEl.style.display === 'none' || highlightEl.style.opacity === '0';
    if (hiWasHidden) {
