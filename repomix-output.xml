/* Active Round 15: Clean, Solid Poster Typography with Random Quote Support */
.hero-title {
  font-family: var(--font-poster, 'Montserrat', 'Be Vietnam Pro', 'Anton', sans-serif);
  display: block;
  padding-top: 8px;
  padding-bottom: 8px;
  margin-bottom: 16px;
  line-height: 1.14;
  text-transform: uppercase;
  letter-spacing: -0.04em;
  font-size: clamp(2.0rem, 4.8vw, 3.4rem);
  transform: translateZ(0);
  word-break: break-word;
  overflow-wrap: break-word;
}

.hero-title-main,
.hero-title-sub {
  display: inline;
  font-family: var(--font-poster, 'Montserrat', 'Be Vietnam Pro', 'Anton', sans-serif);
  font-weight: 900;
  text-transform: uppercase;
  font-size: inherit;
  letter-spacing: -0.04em;
  color: #ffffff !important;
  -webkit-text-fill-color: #ffffff !important;
  text-shadow: 0 4px 14px rgba(0, 0, 0, 0.95), 0 2px 4px rgba(0, 0, 0, 0.9);
  filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.9));
  transform: translateZ(0);
  will-change: transform;
}

/* Round 15: Solid Accent Color (#e879f9) — No gradient, no italic, no glow */
.hero-title-accent {
  display: inline;
  font-family: var(--font-poster, 'Montserrat', 'Be Vietnam Pro', 'Anton', sans-serif);
  font-style: normal !important;
  font-weight: 900;
  text-transform: uppercase;
  font-size: inherit;
  letter-spacing: -0.04em;
  color: #e879f9 !important;
  -webkit-text-fill-color: #e879f9 !important;
  background: none !important;
  -webkit-background-clip: unset !important;
  background-clip: unset !important;
  text-shadow: 0 4px 14px rgba(0, 0, 0, 0.95);
  /* will-change: opacity; */
  filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.9));
  transform: none !important;
  transition: none !important;
  cursor: default;
}

.hero-title-accent::after {
  display: none !important;
}

.hero-title-accent:hover {
  transform: none !important;
}

.hero-desc {
  color: var(--text-secondary);
  max-width: 580px;
  margin-bottom: 22px;
  font-size: 1.05rem;
  line-height: 1.55;
}
.hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

/* ========== DAILY GOAL RADIAL PROGRESS (Vòng 7 Radial Point of Interest) ========== */
