// Pause all animations when tab is hidden to save battery & CPU/GPU cycles
document.addEventListener('visibilitychange', () => {
  if (document.hidden) {
    document.body.classList.add('tab-hidden');
  } else {
    document.body.classList.remove('tab-hidden');
