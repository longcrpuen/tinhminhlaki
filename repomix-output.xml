  // Item 1 ("Lật thẻ"): col 1 => row 2
  // Item 2 ("Thi thử"): col 2 => row 2
  // Item 3 ("+ Thêm câu"): col 1 => row 3
  // Item 4 ("🔄 Reset"): col 2 => row 3
  const buttons = ['Ôn tập', 'Lật thẻ', 'Thi thử', '+ Thêm câu', '🔄 Reset'];
