  </div>

  <!-- MODAL: Manage Subject (Edit, Merge, Delete) -->
  <div id="modal-manage-subject" class="modal-overlay">
    <div class="modal-box" style="max-width: 520px;">
      <div class="modal-header">
        <h3 class="modal-title" id="manage-subject-modal-title">⚙️ Quản Lý Môn Học</h3>
        <button class="icon-btn modal-close" style="width: 32px; height: 32px;">✕</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="manage-subject-id">
        <div class="form-group">
          <label class="form-label" for="manage-subject-name">Tên môn học:</label>
          <input type="text" id="manage-subject-name" class="form-control">
