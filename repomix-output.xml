              </button>
              <div class="cyber-dropdown-menu" id="manage-subject-delete-dropdown-menu" role="listbox" style="width: 100%; min-width: 100%; box-sizing: border-box;"></div>
            </div>
            <select id="manage-subject-delete-target" class="form-control" style="display: none;"></select>
          </div>
          <button class="btn btn-danger" style="width: 100%;" onclick="App.confirmDeleteCurrentSubject()">🗑️ Xóa Môn Học Này</button>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary modal-close">Đóng</button>
      </div>
    </div>
  </div>

  <!-- MODAL: Bulk Reassign Decks to Subject -->
  <div id="modal-bulk-reassign-decks" class="modal-overlay">
    <div class="modal-box" style="max-width: 580px;">
      <div class="modal-header">
