  toggleLmsNewDeckFields() {
    const select = document.getElementById('lms-deck-select');
    const newFields = document.getElementById('lms-new-deck-fields');
    if (select && newFields) {
      newFields.style.display = select.value === '__new__' ? 'block' : 'none';
    }
  },

