   0. QUIZ & FLASHCARD CONTAINER EXPANSION FOR DESKTOP
   -------------------------------------------------------------------------- */
#view-study .quiz-container,
#view-exam .quiz-container,
body.flashcard-active .quiz-container,
body.quiz-active .quiz-container {
  max-width: 860px !important;
  width: 100% !important;
  margin-left: auto !important;
  margin-right: auto !important;
}

/* --------------------------------------------------------------------------
   1. QUIZ PANEL & PROGRESS SYSTEM (.quiz-card, .quiz-progress-track, .quiz-progress-fill)
   -------------------------------------------------------------------------- */

/* Bảng điều khiển học tập Soft Violet thanh thoát, bóng đổ dịu mắt */
#view-study .quiz-card,
#view-exam .quiz-card,
.quiz-card {
  background: var(--bg-card, rgba(24, 18, 42, 0.78)) !important;
  border: 1px solid var(--glass-border, rgba(192, 132, 252, 0.16)) !important;
  border-radius: var(--radius-card, 20px) !important;
  box-shadow: var(--shadow-sm, 0 4px 12px rgba(6, 3, 15, 0.20)) !important;
  position: relative !important;
  overflow: visible !important;
  transform: translateZ(0);
  transition: box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease !important;
  box-sizing: border-box !important;
  max-width: 100% !important;
}

#view-study .quiz-card:hover,
#view-exam .quiz-card:hover {
  border-color: rgba(244, 114, 182, 0.38) !important;
  box-shadow: var(--card-hover-glow, 0 6px 20px rgba(168, 85, 247, 0.14), 0 0 12px rgba(244, 114, 182, 0.10)) !important;
}

/* Rãnh tiến độ lõm nhẹ nhàng */
.quiz-progress-track {
  background: var(--bg-well, rgba(15, 11, 28, 0.75)) !important;
  border: 1px solid rgba(192, 132, 252, 0.18) !important;
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.25) !important;
  border-radius: var(--radius-full, 9999px) !important;
  height: 10px !important;
  margin: 0 14px !important;
  overflow: hidden !important;
  position: relative !important;
  box-sizing: border-box !important;
}

/* Thanh Fill chạy dải quang phổ nhiệt Tím - Hồng Orchid */
.quiz-progress-fill {
  height: 100% !important;
  background: linear-gradient(90deg, #7c3aed 0%, #a855f7 35%, #ec4899 75%, #f472b6 100%) !important;
  box-shadow: 0 0 10px rgba(236, 72, 153, 0.45) !important;
  border-radius: var(--radius-full, 9999px) !important;
  transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

/* Thanh đếm ngược theo câu (Per-Question Countdown Bar) */
.per-q-timer-track {
  background: var(--bg-well, rgba(15, 11, 28, 0.75)) !important;
  border: 1px solid rgba(192, 132, 252, 0.16) !important;
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.2) !important;
  border-radius: var(--radius-full, 9999px) !important;
  height: 6px !important;
  overflow: hidden !important;
  box-sizing: border-box !important;
}
.per-q-timer-fill {
  height: 100% !important;
  background: linear-gradient(90deg, #a855f7 0%, #ec4899 60%, #f472b6 100%) !important;
  box-shadow: 0 0 8px rgba(244, 114, 182, 0.4) !important;
  border-radius: var(--radius-full, 9999px) !important;
  transition: width 1s linear !important;
}

/* Badges & Meta Chips */
.quiz-tag {
  background: rgba(33, 25, 56, 0.85) !important;
  border: 1px solid rgba(192, 132, 252, 0.22) !important;
  box-shadow: var(--shadow-xs) !important;
  color: var(--accent-bright, #c084fc) !important;
  border-radius: var(--radius-full, 9999px) !important;
  font-weight: 600 !important;
  font-size: 0.78rem !important;
  padding: 4px 12px !important;
}

/* Secondary Actions Toolbar */
.card-actions-toolbar .btn-card-action {
  background: rgba(30, 22, 52, 0.75) !important;
  border: 1px solid rgba(192, 132, 252, 0.18) !important;
  box-shadow: var(--shadow-xs) !important;
  color: var(--text-secondary, #cdc3e6) !important;
  border-radius: 10px !important;
  transition: transform 0.15s ease, border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease !important;
}
.card-actions-toolbar .btn-card-action:hover {
  color: #ffffff !important;
  border-color: rgba(244, 114, 182, 0.45) !important;
  transform: translateY(-1px) !important;
  box-shadow: 0 4px 12px rgba(168, 85, 247, 0.18) !important;
}
.card-actions-toolbar .btn-card-action:active {
  transform: translateY(0) scale(0.96) !important;
}

/* Question Headline */
.quiz-question-text {
  color: var(--text-primary, #f8f6fd) !important;
  font-family: var(--font-body, system-ui, sans-serif) !important;
  font-weight: 700 !important;
  line-height: 1.5 !important;
  letter-spacing: -0.015em !important;
  text-shadow: none !important;
}

/* Blind Active Recall Box */
.blind-recall-box {
  background: rgba(20, 14, 38, 0.85) !important;
  border: 1px solid rgba(192, 132, 252, 0.20) !important;
  border-radius: 16px !important;
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.25) !important;
  padding: 24px 20px !important;
  text-align: center !important;
}
.blind-recall-box .btn-reveal-options {
  background: var(--brand-gradient, linear-gradient(135deg, #7c3aed 0%, #9333ea 50%, #db2777 100%)) !important;
  color: #ffffff !important;
  border: 1px solid rgba(255, 255, 255, 0.20) !important;
  box-shadow: 0 4px 12px rgba(168, 85, 247, 0.22) !important;
  border-radius: 9999px !important;
  font-weight: 700 !important;
  padding: 10px 22px !important;
  cursor: pointer !important;
  transition: transform 0.16s ease, box-shadow 0.16s ease !important;
}
.blind-recall-box .btn-reveal-options:hover {
  background: var(--brand-gradient-hover) !important;
  transform: translateY(-1px) !important;
  box-shadow: 0 6px 16px rgba(236, 72, 153, 0.28) !important;
}
.blind-recall-box .btn-reveal-options:active {
  transform: translateY(0) scale(0.98) !important;
}

/* Numeric Answer Input Card */
.numeric-input-card {
  background: rgba(24, 18, 42, 0.78) !important;
  border: 1px solid rgba(192, 132, 252, 0.20) !important;
  border-radius: 16px !important;
  box-shadow: var(--shadow-sm) !important;
  padding: 20px !important;
}
.numeric-input {
  background: var(--bg-well, rgba(15, 11, 28, 0.75)) !important;
  border: 1px solid rgba(192, 132, 252, 0.20) !important;
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.25) !important;
  border-radius: 12px !important;
  color: var(--text-primary, #f8f6fd) !important;
  font-family: var(--font-mono, monospace) !important;
  padding: 12px 16px !important;
  font-size: 1.1rem !important;
}
.numeric-input:focus {
  border-color: var(--border-focus, rgba(244, 114, 182, 0.55)) !important;
  box-shadow: 0 0 12px rgba(244, 114, 182, 0.25) !important;
  outline: none !important;
}


/* --------------------------------------------------------------------------
   2. CLEAN QUIZ OPTIONS (BỎ HOÀN TOÀN KHUNG HỘP BỌC CHỮ CÁI A, B, C, D)
   -------------------------------------------------------------------------- */

/* Bố cục lưới đáp án 2x2 trên Desktop */
.quiz-options-list,
#quiz-options-container,
#exam-options-container,
.bank-card-options-grid {
  display: grid !important;
  grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  gap: 14px 18px !important;
  margin-bottom: 24px !important;
  width: 100% !important;
  box-sizing: border-box !important;
  overflow: visible !important;
}

/* Fallback 1 cột khi gặp công thức toán KaTeX dài */
.quiz-options-list.layout-single-column,
#quiz-options-container.layout-single-column,
#exam-options-container.layout-single-column {
  grid-template-columns: 1fr !important;
}

/* Nút đáp án: Nền tím tối nhẹ nhàng, bo góc 14px, viền mảnh tinh tế, padding thoải mái */
.quiz-option-btn {
  background: rgba(30, 22, 52, 0.75) !important;
  border: 1.5px solid rgba(192, 132, 252, 0.20) !important;
  box-shadow: var(--shadow-xs, 0 1px 2px rgba(0, 0, 0, 0.14)) !important;
  border-radius: 14px !important;
  padding: 14px 18px !important;
  display: flex !important;
  align-items: flex-start !important;
  gap: 10px !important;
  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;
  min-height: 52px !important;
  height: auto !important;
  color: var(--text-primary, #f8f6fd) !important;
  cursor: pointer !important;
  text-align: left !important;
  position: relative !important;
  box-sizing: border-box !important;
  transition: transform 0.15s ease, border-color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease !important;
  user-select: none !important;
  -webkit-user-select: none !important;
  -webkit-tap-highlight-color: transparent !important;
  transform: translateZ(0);
  overflow: hidden !important;
}

.quiz-option-btn:hover:not([disabled]) {
  background: rgba(44, 32, 74, 0.88) !important;
  border-color: rgba(244, 114, 182, 0.50) !important;
  box-shadow: 0 4px 14px rgba(168, 85, 247, 0.16) !important;
  transform: translateY(-1px) !important;
}

.quiz-option-btn:active:not([disabled]) {
  transform: translateY(1px) scale(0.99) !important;
  box-shadow: var(--shadow-xs) !important;
}

/* CHỮ CÁI A. B. C. D.: XÓA SẠCH HỘP VUÔNG, BACKGROUND, BORDER, SHADOW!
   Hiển thị dạng chữ in đậm sắc nét, nằm tự nhiên ngay trước nội dung đáp án */
.quiz-option-letter {
  display: inline !important;
  width: auto !important;
  height: auto !important;
  min-width: 0 !important;
  min-height: 0 !important;
  padding: 0 !important;
  margin: 0 2px 0 0 !important;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  color: #e879f9 !important;
  font-weight: 800 !important;
  font-size: 1rem !important;
  line-height: 1.5 !important;
  flex-shrink: 0 !important;
}

/* Nội dung văn bản / KaTeX đáp án */
.quiz-option-content {
  flex: 1 1 auto !important;
  min-width: 0 !important;
  max-width: 100% !important;
  color: var(--text-primary, #f8f6fd) !important;
  line-height: 1.5 !important;
  font-size: 0.96rem !important;
  font-weight: 500 !important;
  text-align: left !important;
  overflow-wrap: break-word !important;
  word-break: normal !important;
  white-space: normal !important;
}

/* Trạng thái Correct: Phát sáng xanh ngọc nhẹ nhàng */
.quiz-option-btn.correct {
  background: linear-gradient(145deg, rgba(14, 43, 31, 0.90) 0%, rgba(7, 23, 16, 0.94) 100%) !important;
  border: 1.5px solid #34d399 !important;
  box-shadow: 0 0 16px rgba(52, 211, 153, 0.28), var(--shadow-xs) !important;
  color: #ffffff !important;
  animation: keycapCorrectPulse 0.4s cubic-bezier(0.22, 1, 0.36, 1) !important;
}
.quiz-option-btn.correct .quiz-option-letter {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  color: #34d399 !important;
}
.quiz-option-btn.correct .quiz-option-content {
  color: #ffffff !important;
  font-weight: 600 !important;
}

/* Trạng thái Incorrect: Phát sáng đỏ hồng nhẹ nhàng */
.quiz-option-btn.incorrect {
  background: linear-gradient(145deg, rgba(48, 12, 25, 0.90) 0%, rgba(23, 5, 12, 0.94) 100%) !important;
  border: 1.5px solid #ff2a6d !important;
  box-shadow: 0 0 16px rgba(255, 42, 109, 0.28), var(--shadow-xs) !important;
  color: #ffffff !important;
  animation: keycapIncorrectShake 0.36s cubic-bezier(0.22, 1, 0.36, 1) !important;
}
.quiz-option-btn.incorrect .quiz-option-letter {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  color: #ff2a6d !important;
}
.quiz-option-btn.incorrect .quiz-option-content {
  color: #ffffff !important;
  font-weight: 600 !important;
}

/* Animations khi chọn đáp án */
@keyframes keycapCorrectPulse {
  0%   { transform: scale(0.98); }
  50%  { transform: scale(1.02); }
  100% { transform: scale(1); }
}
@keyframes keycapIncorrectShake {
  0%, 100% { transform: translateX(0); }
  20%  { transform: translateX(-4px); }
  40%  { transform: translateX(4px); }
  60%  { transform: translateX(-2px); }
  80%  { transform: translateX(2px); }
}


/* --------------------------------------------------------------------------
   3. KATEX CO GIÃN THÍCH ỨNG & ZERO CUỘN NGANG (Adaptive KaTeX Engine)
   -------------------------------------------------------------------------- */

.katex-inline-wrap {
  display: inline-block;
  vertical-align: middle;
  margin: 0 4px;
  max-width: 100%;
  white-space: nowrap !important;
  overflow: visible !important;
  overflow-x: visible !important;
  scrollbar-width: none !important;
}

/* Co giãn kích thước font KaTeX tự động khi quá dài */
.katex-inline-wrap.katex-scaled-down,
.katex-scaled-down .katex,
.katex-inline-wrap.katex-scaled-down-1,
.katex-scaled-down-1 .katex {
  font-size: 0.88em !important;
}
.katex-inline-wrap.katex-scaled-down-2,
.katex-scaled-down-2 .katex {
  font-size: 0.82em !important;
}

/* Xóa triệt để mọi thanh cuộn scroll lồng nhau trong các ô đáp án */
.katex-inline-wrap::-webkit-scrollbar,
.quiz-option-btn .katex-inline-wrap::-webkit-scrollbar,
.quiz-option-content .katex-inline-wrap::-webkit-scrollbar,
.quiz-options-list .katex-inline-wrap::-webkit-scrollbar,
#quiz-options-container .katex-inline-wrap::-webkit-scrollbar,
#exam-options-container .katex-inline-wrap::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
}

/* KaTeX Display localized scroll safety */
.katex-display-wrap,
.katex-display {
  display: block;
  overflow-x: auto;
  overflow-y: hidden;
  max-width: 100%;
  margin: 8px 0;
  padding: 4px 0;
}


/* --------------------------------------------------------------------------
   4. THẺ FLASHCARD 3D & 4 NÚT SRS SM-2 (#study-flashcard-area, .srs-btn)
   -------------------------------------------------------------------------- */

#study-flashcard-area,
.flashcard-player-container,
body.flashcard-active .flashcard-player-container,
body.flashcard-active #study-flashcard-area {
  max-width: 840px !important;
  margin: 0 auto !important;
  width: 100% !important;
  display: flex;
  flex-direction: column;
  gap: 16px !important;
  box-sizing: border-box !important;
}

.flashcard-stage,
body.flashcard-active .flashcard-stage {
  perspective: 1200px !important;
  -webkit-perspective: 1200px !important;
  width: 100% !important;
  height: clamp(380px, 50vh, 460px) !important;
  min-height: 380px !important;
  max-height: 480px !important;
  display: flex !important;
  flex-direction: column !important;
  position: relative !important;
  margin: 0 auto !important;
}

/* Card lật 3D mượt mà */
.flashcard-card,
.flashcard-inner,
body.flashcard-active .flashcard-card {
  width: 100% !important;
  height: 100% !important;
  min-height: 380px !important;
  max-height: 480px !important;
  position: relative !important;
  transform-style: preserve-3d !important;
  -webkit-transform-style: preserve-3d !important;
  transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1) !important;
  cursor: pointer !important;
  user-select: none !important;
  -webkit-user-select: none !important;
  border-radius: 22px !important;
}

.flashcard-card.flipped,
.flashcard-inner.flipped,
body.flashcard-active .flashcard-card.flipped {
  transform: rotateY(180deg) !important;
  -webkit-transform: rotateY(180deg) !important;
}

/* Mặt thẻ Neumorphic Soft Violet Tactile */
.flashcard-face,
body.flashcard-active .flashcard-face {
  position: absolute !important;
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;
  backface-visibility: hidden !important;
  -webkit-backface-visibility: hidden !important;
  border-radius: 22px !important;
  background: linear-gradient(145deg, rgba(32, 23, 56, 0.94) 0%, rgba(20, 14, 36, 0.96) 100%) !important;
  border: 1px solid rgba(192, 132, 252, 0.26) !important;
  box-shadow: var(--shadow-md, 0 6px 20px rgba(6, 3, 15, 0.24)) !important;
  padding: 28px 36px !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: space-between !important;
  box-sizing: border-box !important;
  overflow: hidden !important;
}

/* Mặt trước */
.flashcard-front,
body.flashcard-active .flashcard-front {
  transform: rotateY(0deg) !important;
  -webkit-transform: rotateY(0deg) !important;
  z-index: 2;
}

/* Mặt sau */
.flashcard-back,
body.flashcard-active .flashcard-back {
  transform: rotateY(180deg) !important;
  -webkit-transform: rotateY(180deg) !important;
  background: linear-gradient(145deg, rgba(38, 25, 66, 0.96) 0%, rgba(22, 14, 40, 0.98) 100%) !important;
  border-color: rgba(244, 114, 182, 0.42) !important;
  box-shadow: var(--shadow-md), 0 0 20px rgba(168, 85, 247, 0.16) !important;
  z-index: 1;
}

.flashcard-card.flipped .flashcard-front,
body.flashcard-active .flashcard-card.flipped .flashcard-front {
  z-index: 1 !important;
  pointer-events: none;
}
.flashcard-card.flipped .flashcard-back,
body.flashcard-active .flashcard-card.flipped .flashcard-back {
  z-index: 3 !important;
  pointer-events: auto;
}

/* Nội dung bên trong thẻ Flashcard */
.flashcard-face-header,
body.flashcard-active .flashcard-face-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  flex-shrink: 0;
}
.flashcard-flip-badge,
body.flashcard-active .flashcard-flip-badge {
  font-size: 0.78rem !important;
  font-weight: 600 !important;
  color: var(--accent-rose, #f472b6) !important;
  letter-spacing: 0.03em !important;
}

.flashcard-content-wrap,
body.flashcard-active .flashcard-content-wrap {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 10px 0;
  text-align: center;
  word-break: break-word;
}

/* Cỡ chữ câu hỏi thoáng đãng */
.flashcard-question-text,
body.flashcard-active .flashcard-question-text {
  font-size: clamp(1.25rem, 2.1vw, 1.55rem) !important;
  font-weight: 700 !important;
  color: var(--text-primary, #f8f6fd) !important;
  line-height: 1.55 !important;
  margin: 0 !important;
}

/* Nhãn đáp án đúng */
.flashcard-answer-label,
body.flashcard-active .flashcard-answer-label {
  font-size: 0.76rem !important;
  font-weight: 800 !important;
  color: #34d399 !important;
  letter-spacing: 0.08em !important;
  margin-bottom: 8px !important;
}

/* Cỡ chữ đáp án lớn rõ, nổi bật */
.flashcard-answer-text,
body.flashcard-active .flashcard-answer-text {
  font-size: clamp(1.3rem, 2.2vw, 1.65rem) !important;
  font-weight: 800 !important;
  color: #34d399 !important;
  line-height: 1.45 !important;
  margin: 0 0 12px 0 !important;
  text-shadow: 0 0 16px rgba(52, 211, 153, 0.35) !important;
}

/* Hốc giải thích lõm nhẹ nhàng trong Flashcard Back */
.flashcard-explanation-box,
body.flashcard-active .flashcard-explanation-box {
  background: var(--bg-well, rgba(15, 11, 28, 0.75)) !important;
  border: 1px solid rgba(192, 132, 252, 0.20) !important;
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.25) !important;
  border-radius: 14px !important;
  padding: 12px 18px !important;
  text-align: left !important;
  margin-top: 10px !important;
}
.flashcard-explanation-header,
body.flashcard-active .flashcard-explanation-header {
  font-size: 0.78rem !important;
  font-weight: 700 !important;
  color: var(--accent-rose, #f472b6) !important;
  margin-bottom: 4px !important;
}
.flashcard-explanation-text,
body.flashcard-active .flashcard-explanation-text {
  font-size: 0.88rem !important;
  line-height: 1.55 !important;
  color: var(--text-secondary, #cdc3e6) !important;
}

/* Bottom Actions Toolbar */
.flashcard-bottom-actions,
body.flashcard-active .flashcard-bottom-actions {
  max-width: 840px !important;
  margin-top: 12px !important;
  width: 100% !important;
}

/* 4 Phím Đánh Giá SRS SM-2 */
.srs-ratings-bar,
body.flashcard-active .srs-ratings-bar {
  display: grid !important;
  grid-template-columns: repeat(2, 1fr) !important;
  gap: 12px !important;
  width: 100% !important;
  box-sizing: border-box !important;
  margin-top: 12px !important;
}

.srs-btn,
body.flashcard-active .srs-btn {
  height: 54px !important;
  min-height: 54px !important;
  border-radius: 14px !important;
  background: linear-gradient(145deg, rgba(30, 22, 52, 0.85) 0%, rgba(18, 12, 34, 0.92) 100%) !important;
  box-shadow: var(--shadow-xs) !important;
  border: 1px solid rgba(192, 132, 252, 0.22) !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 3px !important;
  padding: 6px 10px !important;
  box-sizing: border-box !important;
  cursor: pointer !important;
  transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1),
              box-shadow 0.16s ease,
              border-color 0.16s ease !important;
  user-select: none !important;
}

.srs-btn:hover,
body.flashcard-active .srs-btn:hover {
