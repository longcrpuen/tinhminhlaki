                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </button>
              <div class="cyber-dropdown-menu" id="manage-subject-merge-dropdown-menu" role="listbox" style="width: 100%; min-width: 100%; box-sizing: border-box;"></div>
            </div>
            <select id="manage-subject-merge-target" class="form-control" style="display: none;"></select>
            <button class="btn btn-secondary" onclick="App.mergeCurrentSubject()" style="white-space: nowrap; height: 42px;">🔀 Gộp Môn</button>
          </div>
          <small style="color: var(--text-secondary); display: block; margin-top: 4px;">Toàn bộ bộ thẻ của môn này sẽ được chuyển sang môn đích, môn hiện tại sẽ được xóa.</small>
