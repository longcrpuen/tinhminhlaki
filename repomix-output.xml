<file path="css/thermal-tools.css">
/* ==========================================================================
   MINDSPARKS / TINHMINHLAKEY — THERMAL TOOLS & DROPDOWN Z-INDEX ENGINE
   Module: css/thermal-tools.css (Sub-Agent C - Exclusive File)
   Stack: Soft Violet-Rose & Low-Shadow Airy Surfaces
   Views:
     - Z-Index & Stacking Context Hotfix (Universal Dropdowns)
     - Ngân Hàng Câu Hỏi (#view-bank)
     - Dán AI (#view-import)
     - Nhập LMS (#view-import-lms)
     - Heatmap 365 Ngày FLIR & Thống Kê (#view-stats)
     - Cài Đặt & Sao Lưu Dữ Liệu (#view-settings)
   ========================================================================== */

/* ==========================================================================
   MỤC 1: VÁ DỨT ĐIỂM LỖI STACKING CONTEXT & Z-INDEX DROPDOWN (BẢO TOÀN 100%)
   Đảm bảo 100% Dropdown trong tab Dán AI, Nhập LMS, Ngân Hàng Câu Hỏi, Cài Đặt
   và Modals luôn nổi lên tầng trên cùng (z-index: 10000 !important) và không bị
   bất kỳ ô input, textarea hay thẻ bên dưới đè lên.
   ========================================================================== */

/* 1.1 Reset stacking context cho toàn bộ con trực tiếp trong các card lớn */
.deck-card > *,
.subject-group > *,
.stat-card > *,
.quiz-card > *,
.bank-card-item > *,
.glass-card > *,
.study-mode-card > * {
  position: relative;
  z-index: auto !important;
}

/* 1.2 Khi có cyber-dropdown mở: gỡ bỏ hoàn toàn clipping overflow và contain isolation */
.quiz-card:has(.cyber-dropdown.open),
.lms-config-card:has(.cyber-dropdown.open),
.hero-card:has(.cyber-dropdown.open),
.modal-box:has(.cyber-dropdown.open),
.settings-card:has(.cyber-dropdown.open),
.bank-card-item:has(.cyber-dropdown.open),
.lms-preview-card:has(.cyber-dropdown.open),
.glass-card:has(.cyber-dropdown.open) {
  overflow: visible !important;
  contain: none !important;
  z-index: 500 !important;
}

/* 1.3 Nâng stacking context của container cha chứa dropdown mở lên tầng cao nhất (9990) */
.form-group:has(.cyber-dropdown.open),
.lms-config-grid:has(.cyber-dropdown.open),
.bank-filter-bar:has(.cyber-dropdown.open),
.lms-preview-card:has(.cyber-dropdown.open),
.lms-card-actions:has(.cyber-dropdown.open),
.lms-meta-row:has(.cyber-dropdown.open),
.settings-group:has(.cyber-dropdown.open),
.modal-body:has(.cyber-dropdown.open),
.bg-custom-bar:has(.cyber-dropdown.open) {
  position: relative !important;
  z-index: 9990 !important;
}

/* 1.4 Quy chuẩn z-index phân tầng cho bản thân Dropdown & Dropdown Menu */
.cyber-dropdown {
  position: relative;
  z-index: 10;
}

.cyber-dropdown.open {
  position: relative !important;
  z-index: 9999 !important;
}

.cyber-dropdown.open .cyber-dropdown-menu {
  z-index: 10000 !important;
  background: linear-gradient(160deg, rgba(27, 16, 51, 0.98) 0%, rgba(13, 7, 26, 0.98) 100%) !important;
  border: 1px solid rgba(244, 114, 182, 0.45) !important;
  box-shadow:
    0 16px 36px rgba(6, 3, 15, 0.45),
    0 0 16px rgba(168, 85, 247, 0.20),
    inset 0 1px 0 rgba(255, 255, 255, 0.12) !important;
}

/* ==========================================================================
   MỤC 2: CYBER VIOLET & SOFT ROSE DROPDOWN UI POLISH (AIRY LOW-SHADOW)
   ========================================================================== */

.cyber-dropdown-trigger {
  background: rgba(24, 18, 42, 0.78) !important;
  border: 1px solid rgba(192, 132, 252, 0.22) !important;
  box-shadow: var(--shadow-xs) !important;
  border-radius: 12px !important;
  color: var(--text-primary) !important;
  font-weight: 500 !important;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

.cyber-dropdown-trigger:hover,
.cyber-dropdown.open .cyber-dropdown-trigger {
  border-color: rgba(244, 114, 182, 0.55) !important;
  box-shadow:
    0 4px 14px rgba(244, 114, 182, 0.20),
    inset 0 1px 1px rgba(255, 255, 255, 0.12) !important;
  color: #ffffff !important;
}

.cyber-dropdown-chevron {
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease !important;
  color: var(--text-muted) !important;
}

.cyber-dropdown.open .cyber-dropdown-chevron {
  transform: rotate(180deg) !important;
  color: var(--accent-rose, #f472b6) !important;
}

.cyber-dropdown-menu {
  border-radius: 14px !important;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 6px !important;
  scrollbar-width: thin;
  scrollbar-color: rgba(192, 132, 252, 0.35) #0d0917;
}

.cyber-dropdown-menu::-webkit-scrollbar {
  width: 6px;
}

.cyber-dropdown-menu::-webkit-scrollbar-track {
  background: #0d0917;
  border-radius: 6px;
}

.cyber-dropdown-menu::-webkit-scrollbar-thumb {
  background: rgba(192, 132, 252, 0.35);
  border-radius: 6px;
}

.cyber-dropdown-menu::-webkit-scrollbar-thumb:hover {
  background: var(--accent-rose, #f472b6);
}

.cyber-dropdown-item {
  border-radius: 8px !important;
  color: var(--text-secondary) !important;
  padding: 9px 12px !important;
  font-size: 0.88rem !important;
  transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1) !important;
  border: 1px solid transparent !important;
}

.cyber-dropdown-item:hover,
.cyber-dropdown-item.active,
.cyber-dropdown-item:focus-visible {
  background: linear-gradient(90deg, rgba(168, 85, 247, 0.20) 0%, rgba(244, 114, 182, 0.16) 100%) !important;
  border-color: rgba(244, 114, 182, 0.32) !important;
  color: #ffffff !important;
  outline: none !important;
  box-shadow: inset 0 0 8px rgba(244, 114, 182, 0.16) !important;
  transform: translateX(2px);
}

.cyber-dropdown-item .item-count {
  font-family: var(--font-mono, monospace);
  font-size: 0.76rem !important;
  background: rgba(168, 85, 247, 0.15);
  color: var(--accent-bright) !important;
  padding: 2px 7px;
  border-radius: 6px;
  border: 1px solid rgba(192, 132, 252, 0.22);
}

.cyber-dropdown-item:hover .item-count,
.cyber-dropdown-item.active .item-count {
  background: rgba(244, 114, 182, 0.22);
  color: #ffffff !important;
  border-color: rgba(244, 114, 182, 0.40);
}

/* ==========================================================================
   MỤC 3: LÀM NHẸ BÓNG ĐỔ (LOW-SHADOW AIRY THEME) CHO TOÀN BỘ Ô INPUT & TEXTAREA
   Giảm độ đậm hốc lõm đen đặc, viền tím mảnh thanh thoát 1px solid rgba(192, 132, 252, 0.22)
   và bóng đổ lõm nhẹ nhàng inset 0 1px 3px rgba(0, 0, 0, 0.25).
   Khi focus đổi sang viền hồng pastel border-color: rgba(244, 114, 182, 0.55) kèm hào quang dịu mắt.
   ========================================================================== */

.form-control,
.bank-search-input,
.lms-question-edit-box,
.lms-numeric-input,
.bg-url-input,
.numeric-input,
#lms-batch-answers,
textarea#import-raw-input,
#lms-raw-input.lms-textarea {
  background: var(--bg-well) !important;
  border: 1px solid rgba(192, 132, 252, 0.22) !important;
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.25) !important;
  color: var(--text-primary) !important;
  transition: border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1),
              box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1),
              background-color 0.2s ease !important;
}

.form-control:focus,
.bank-search-input:focus,
.lms-question-edit-box:focus,
.lms-numeric-input:focus,
.bg-url-input:focus,
.numeric-input:focus,
#lms-batch-answers:focus,
textarea#import-raw-input:focus,
#lms-raw-input.lms-textarea:focus {
  border-color: rgba(244, 114, 182, 0.55) !important;
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.25), 0 0 12px rgba(244, 114, 182, 0.22) !important;
  outline: none !important;
}

.form-control::placeholder,
.bank-search-input::placeholder,
.lms-question-edit-box::placeholder,
.lms-numeric-input::placeholder,
.bg-url-input::placeholder,
#lms-batch-answers::placeholder,
textarea#import-raw-input::placeholder,
#lms-raw-input.lms-textarea::placeholder {
  color: var(--text-muted) !important;
  opacity: 0.70;
}

/* ==========================================================================
   MỤC 4: BIỂU ĐỒ HEATMAP 365 NGÀY — CAMERA NHIỆT HỒNG NGOẠI (FLIR) DỊU MẮT
   Hiển thị sắc nét, trong trẻo, hòa quyện với theme Tím - Hồng mới.
   ========================================================================== */

.heatmap-card {
  background: var(--bg-card) !important;
  border: 1px solid var(--glass-border) !important;
  box-shadow: var(--shadow-sm) !important;
  border-radius: var(--radius-card, 20px) !important;
  padding: 24px !important;
  position: relative;
  overflow: hidden;
}

.heatmap-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--thermal-spectrum, linear-gradient(90deg, #7c3aed 0%, #a855f7 25%, #ec4899 50%, #f472b6 75%, #fde047 100%));
  opacity: 0.85;
}

.heatmap-grid {
  gap: 4px;
}

.heatmap-cell {
  border-radius: 3px !important;
  transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1),
              box-shadow 0.15s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

.heatmap-cell:hover {
  transform: scale(1.45) !important;
  z-index: 30 !important;
}

/* Thang màu 5 cấp độ Camera Nhiệt Tím - Hồng FLIR mềm mại */
.heatmap-cell.level-0 {
  background: #110b22 !important;
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.45) !important;
  border: 1px solid rgba(192, 132, 252, 0.08) !important;
}

.heatmap-cell.level-1 {
  background: #581c87 !important;
  border: 1px solid rgba(168, 85, 247, 0.30) !important;
  box-shadow: 0 0 4px rgba(88, 28, 135, 0.35) !important;
}

.heatmap-cell.level-2 {
  background: #9333ea !important;
  border: 1px solid rgba(192, 132, 252, 0.45) !important;
  box-shadow: 0 0 6px rgba(147, 51, 234, 0.40) !important;
}

.heatmap-cell.level-3 {
  background: #db2777 !important;
  border: 1px solid rgba(244, 114, 182, 0.55) !important;
  box-shadow: 0 0 8px rgba(219, 39, 119, 0.45) !important;
}

.heatmap-cell.level-4 {
  background: #ec4899 !important;
  border: 1px solid #fde047 !important;
  box-shadow: 0 0 10px rgba(236, 72, 153, 0.60), 0 0 4px #fde047 !important;
}

.heatmap-cell.today {
  outline: 2px solid var(--accent-rose, #f472b6) !important;
  outline-offset: 1px !important;
  animation: thermalPulseToday 2.2s infinite ease-in-out;
}

@keyframes thermalPulseToday {
  0%, 100% { outline-color: #fde047; }
  50% { outline-color: #f472b6; }
}

.heatmap-legend {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 14px;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.heatmap-legend .heatmap-cell {
  width: 13px;
  height: 13px;
}

/* ==========================================================================
   MỤC 5: GIAO DIỆN NGÂN HÀNG CÂU HỎI (#view-bank)
   ========================================================================== */

#view-bank .bank-header-wrap {
  border-bottom: 1px solid rgba(192, 132, 252, 0.16);
  padding-bottom: 18px;
  margin-bottom: 22px;
}

#view-bank .bank-main-heading {
  background: linear-gradient(135deg, #f8f6fd 20%, #c084fc 60%, #f472b6 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: 800;
  letter-spacing: -0.02em;
}

#view-bank .bank-filter-bar {
  display: flex;
  gap: 12px;
  margin-bottom: 20px;
  flex-wrap: wrap;
  align-items: center;
}

#view-bank .bank-search-input {
  min-height: 46px;
  padding: 11px 20px;
  border-radius: var(--radius-full, 9999px) !important;
  font-size: 0.92rem;
}

/* Chips lọc chủ đề phong cách Soft Violet HUD */
.bank-topic-chips {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 4px 2px 12px 2px;
  margin-bottom: 18px;
  scrollbar-width: thin;
  scrollbar-color: rgba(192, 132, 252, 0.3) transparent;
}

.bank-topic-chip {
  padding: 6px 14px;
  border-radius: var(--radius-full, 9999px);
  background: rgba(24, 18, 42, 0.78);
  border: 1px solid rgba(192, 132, 252, 0.18);
  color: var(--text-secondary);
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  box-shadow: var(--shadow-xs);
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}

.bank-topic-chip:hover {
  border-color: rgba(244, 114, 182, 0.45);
  color: #ffffff;
  transform: translateY(-1px);
}

.bank-topic-chip.active {
  background: var(--brand-gradient, linear-gradient(135deg, #7c3aed 0%, #9333ea 50%, #db2777 100%)) !important;
  color: #ffffff !important;
  border-color: rgba(255, 255, 255, 0.25) !important;
  box-shadow: 0 4px 12px rgba(168, 85, 247, 0.25) !important;
}

/* Thẻ câu hỏi trong Ngân hàng (Low-Shadow Airy Card) */
.bank-card-item {
  background: var(--bg-card) !important;
  border: 1px solid var(--glass-border) !important;
  border-radius: var(--radius-card, 20px) !important;
  padding: 22px !important;
  margin-bottom: 18px !important;
  box-shadow: var(--shadow-sm) !important;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
  content-visibility: auto;
  contain-intrinsic-size: 0 180px;
}

.bank-card-item:hover {
  border-color: rgba(244, 114, 182, 0.38) !important;
  box-shadow: var(--card-hover-glow) !important;
  transform: translateY(-2px);
}

/* Lưới hiển thị các phương án đáp án trong ngân hàng */
.bank-card-options-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 10px;
  margin-top: 14px;
}

.bank-card-options-grid > div {
  padding: 10px 14px;
  border-radius: 12px;
  background: rgba(20, 14, 38, 0.65);
  border: 1px solid rgba(192, 132, 252, 0.14);
  font-size: 0.88rem;
  color: var(--text-secondary);
  line-height: 1.45;
  transition: all 0.15s ease;
}

.bank-card-options-grid > div.bank-option-correct,
.bank-card-options-grid > div[style*="border-color: var(--success)"],
.bank-card-options-grid > div[style*="border-color: #10B981"] {
  background: rgba(52, 211, 153, 0.12) !important;
  border: 1px solid rgba(52, 211, 153, 0.45) !important;
  box-shadow: 0 0 8px rgba(52, 211, 153, 0.16) !important;
  color: #f0fdf4 !important;
}

/* Nút thao tác trên thẻ ngân hàng (Bookmark ⭐, Flag 🚩, Edit ✏️) */
.bank-card-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.bank-action-btn {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-well);
  border: 1px solid rgba(192, 132, 252, 0.20);
  color: var(--text-muted);
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.20);
  cursor: pointer;
  transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
}

.bank-action-btn:hover {
  border-color: rgba(244, 114, 182, 0.50);
  color: #ffffff;
  transform: translateY(-1px);
}

.bank-action-btn.active,
.bank-action-btn.bookmarked {
  color: #fde047 !important;
  border-color: rgba(253, 224, 71, 0.50) !important;
  box-shadow: 0 0 8px rgba(253, 224, 71, 0.25), inset 0 1px 2px rgba(0, 0, 0, 0.20) !important;
}

.bank-action-btn.flagged {
  color: var(--danger, #f43f5e) !important;
  border-color: rgba(244, 63, 94, 0.50) !important;
  box-shadow: 0 0 8px rgba(244, 63, 94, 0.25), inset 0 1px 2px rgba(0, 0, 0, 0.20) !important;
}

/* ==========================================================================
   MỤC 6: GIAO DIỆN DÁN CÂU HỎI AI (#view-import)
   ========================================================================== */

#view-import .hero-card {
  background: var(--bg-card) !important;
  border: 1px solid var(--glass-border) !important;
  box-shadow: var(--shadow-sm) !important;
  border-radius: var(--radius-card, 20px) !important;
  position: relative;
  overflow: hidden;
}

#view-import .hero-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, #7c3aed 0%, #a855f7 50%, #f472b6 100%);
}

#view-import .quiz-card {
  background: var(--bg-card) !important;
  border: 1px solid var(--glass-border) !important;
  box-shadow: var(--shadow-sm) !important;
  border-radius: var(--radius-card, 20px) !important;
  padding: 26px !important;
}

#view-import textarea#import-raw-input {
  min-height: 200px !important;
  font-family: var(--font-mono, monospace) !important;
  font-size: 0.85rem !important;
  line-height: 1.6 !important;
  border-radius: 14px !important;
  padding: 16px 18px !important;
}

#import-validation-alert {
  padding: 12px 16px;
  border-radius: 12px;
  margin-top: 14px;
  font-size: 0.88rem;
  line-height: 1.5;
}

#import-validation-alert.alert-success {
  background: rgba(52, 211, 153, 0.12) !important;
  border: 1px solid rgba(52, 211, 153, 0.35) !important;
  color: #34d399 !important;
}

#import-validation-alert.alert-danger {
  background: rgba(244, 63, 94, 0.12) !important;
  border: 1px solid rgba(244, 63, 94, 0.35) !important;
  color: #f43f5e !important;
}

/* ==========================================================================
   MỤC 7: GIAO DIỆN NHẬP LMS (#view-import-lms) & PREVIEW CARDS
   ========================================================================== */

.lms-config-card {
  background: var(--bg-card) !important;
  border: 1px solid var(--glass-border) !important;
  box-shadow: var(--shadow-sm) !important;
  border-radius: var(--radius-card, 20px) !important;
  padding: 24px !important;
}

.lms-format-guide-card {
  background: rgba(20, 14, 38, 0.70) !important;
  border: 1px solid rgba(192, 132, 252, 0.16) !important;
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.20) !important;
  border-radius: 14px !important;
  padding: 16px !important;
  margin-top: 16px;
  margin-bottom: 16px;
}

.lms-sample-snippet {
  background: rgba(13, 9, 23, 0.85) !important;
  border: 1px solid rgba(192, 132, 252, 0.14) !important;
  border-radius: 10px !important;
  padding: 12px 14px !important;
  font-family: var(--font-mono, monospace) !important;
  font-size: 0.78rem !important;
  color: var(--text-secondary) !important;
}

.lms-sample-line.header-line {
  color: var(--accent-bright) !important;
  font-weight: 700;
}

.lms-sample-line.q-line {
  color: #ffffff !important;
  margin: 4px 0;
}

.lms-sample-line.choice-line {
  color: #d0c4ea !important;
}

#lms-raw-input.lms-textarea {
  min-height: 200px !important;
  font-family: var(--font-mono, monospace) !important;
  font-size: 0.86rem !important;
  line-height: 1.55 !important;
  border-radius: 14px !important;
}

/* Khối gán đáp án hàng loạt */
#lms-batch-panel {
  background: var(--bg-card) !important;
  border: 1px solid var(--glass-border) !important;
  box-shadow: var(--shadow-sm) !important;
  border-radius: var(--radius-card, 20px) !important;
  padding: 20px 24px !important;
}

/* Thẻ xem trước từng câu hỏi LMS (Preview Cards) */
.lms-preview-card {
  background: var(--bg-card) !important;
  border: 1px solid var(--glass-border) !important;
  border-radius: 16px !important;
  padding: 20px 22px !important;
  margin-bottom: 16px !important;
  box-shadow: var(--shadow-sm) !important;
  transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
  content-visibility: auto;
  contain-intrinsic-size: 0 200px;
}

.lms-preview-card:hover {
  border-color: rgba(244, 114, 182, 0.38) !important;
  box-shadow: var(--card-hover-glow) !important;
}

.lms-preview-card.needs-review {
  border-color: rgba(244, 63, 94, 0.45) !important;
  background: linear-gradient(180deg, rgba(244, 63, 94, 0.08) 0%, rgba(24, 18, 42, 0.90) 100%) !important;
  box-shadow: 0 0 12px rgba(244, 63, 94, 0.16) !important;
}

.lms-question-edit-box {
  border-radius: 12px !important;
  padding: 12px 14px !important;
  font-size: 0.92rem !important;
  line-height: 1.5 !important;
  margin-bottom: 12px !important;
}

/* Các hàng phương án trắc nghiệm trong thẻ LMS */
.lms-option-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 12px;
  border-radius: 12px !important;
  background: var(--bg-well) !important;
  border: 1px solid rgba(192, 132, 252, 0.18) !important;
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.20) !important;
  margin-bottom: 8px;
  transition: all 0.15s ease !important;
}

.lms-option-row.is-correct {
  border-color: rgba(52, 211, 153, 0.50) !important;
  background: rgba(52, 211, 153, 0.10) !important;
  box-shadow: 0 0 8px rgba(52, 211, 153, 0.16) !important;
}

.lms-option-row .lms-option-letter {
  font-weight: 700;
  font-size: 0.88rem;
  color: var(--accent-bright);
}

.lms-option-row.is-correct .lms-option-letter {
  color: #34d399 !important;
}

.lms-numeric-row {
  background: var(--bg-well) !important;
  border: 1px dashed rgba(192, 132, 252, 0.30) !important;
  border-radius: 12px !important;
  padding: 10px 14px !important;
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.20) !important;
}

/* ==========================================================================
   MỤC 8: BẢNG ĐIỀU KHIỂN THỐNG KÊ (#view-stats)
   ========================================================================== */

#view-stats .stat-card {
  background: var(--bg-card) !important;
  border: 1px solid var(--glass-border) !important;
  border-radius: 16px !important;
  box-shadow: var(--shadow-sm) !important;
  padding: 20px !important;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

#view-stats .stat-card:hover {
  border-color: rgba(244, 114, 182, 0.38) !important;
  box-shadow: var(--card-hover-glow) !important;
  transform: translateY(-2px);
}

/* Thẻ Chuỗi ngày kiên trì (Soft Orchid Rose Glow) */
.stat-card-streak {
  background: linear-gradient(145deg, rgba(38, 20, 54, 0.82) 0%, rgba(20, 14, 38, 0.88) 100%) !important;
  border: 1px solid rgba(244, 114, 182, 0.30) !important;
  box-shadow: var(--shadow-sm) !important;
}

.streak-flame-glow {
  box-shadow: 0 0 14px rgba(244, 114, 182, 0.40) !important;
  background: linear-gradient(135deg, #ec4899 0%, #f472b6 100%) !important;
  color: #ffffff !important;
}

/* Khối phân bố cấp độ ghi nhớ SM-2 */
.sm2-distribution-card {
  background: var(--bg-card) !important;
  border: 1px solid var(--glass-border) !important;
  box-shadow: var(--shadow-sm) !important;
  border-radius: var(--radius-card, 20px) !important;
  padding: 24px !important;
}

.sm2-breakdown-grid > div {
  background: var(--bg-well) !important;
  border: 1px solid rgba(192, 132, 252, 0.16) !important;
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.18) !important;
  border-radius: 14px !important;
  padding: 16px !important;
  text-align: center;
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.sm2-breakdown-grid > div:hover {
  border-color: rgba(244, 114, 182, 0.45);
  transform: translateY(-2px);
}

/* Bảng hiệu suất theo môn học và chủ đề */
#view-stats table {
  width: 100%;
  border-collapse: collapse;
}

#view-stats table th {
  padding: 12px 14px;
  color: var(--text-muted);
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 1px solid rgba(192, 132, 252, 0.16);
}

#view-stats table td {
  padding: 14px;
  border-bottom: 1px solid rgba(192, 132, 252, 0.10);
  color: var(--text-primary);
  font-size: 0.9rem;
}

#view-stats table tbody tr {
  transition: background-color 0.15s ease;
}

#view-stats table tbody tr:hover {
  background: rgba(168, 85, 247, 0.06);
}

/* ==========================================================================
   MỤC 9: CÀI ĐẶT & SAO LƯU DỮ LIỆU (#view-settings)
   ========================================================================== */

#view-settings .quiz-card {
  background: var(--bg-card) !important;
  border: 1px solid var(--glass-border) !important;
  box-shadow: var(--shadow-sm) !important;
  border-radius: var(--radius-card, 20px) !important;
  padding: 24px !important;
  margin-bottom: 20px !important;
}

#view-settings .bg-thumb {
  border: 2px solid rgba(192, 132, 252, 0.18) !important;
  box-shadow: var(--shadow-xs) !important;
  transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease !important;
}

#view-settings .bg-thumb:hover {
  border-color: rgba(244, 114, 182, 0.50) !important;
  box-shadow: var(--shadow-sm) !important;
  transform: translateY(-2px) !important;
}

#view-settings .bg-thumb.active {
  border-color: var(--accent-rose, #f472b6) !important;
  box-shadow: 0 0 12px rgba(244, 114, 182, 0.35) !important;
}

#view-settings .bg-custom-bar {
  display: flex;
  gap: 10px;
  margin-top: 14px;
  align-items: center;
  flex-wrap: wrap;
}

#view-settings .bg-custom-bar .bg-url-input {
  flex: 1;
  min-width: 220px;
}

/* ==========================================================================
   MỤC 10: TỐI ƯU HÓA RESPONSIVE & MOBILE HUD
   ========================================================================== */

@media (max-width: 640px) {
  .bank-filter-bar {
    flex-direction: column !important;
    align-items: stretch !important;
  }

  .bank-filter-bar .bank-search-input,
  .bank-filter-bar .cyber-dropdown {
    width: 100% !important;
    min-width: 100% !important;
  }

  .cyber-dropdown.open .cyber-dropdown-menu {
    width: 100% !important;
    min-width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
  }

  .bank-card-options-grid {
    grid-template-columns: 1fr !important;
  }

  .lms-preview-card {
    padding: 16px !important;
  }
}
