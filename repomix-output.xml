          <p style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 8px;">
            Nếu môn này còn bộ thẻ, hệ thống yêu cầu chọn môn chuyển sang để bảo đảm không mất dữ liệu.
          </p>
          <div id="manage-subject-delete-reassign-wrap" style="display: none; margin-bottom: 8px;">
            <label class="form-label" style="font-size: 0.8rem; margin-bottom: 6px;">Chuyển các bộ thẻ sang:</label>
            <div class="cyber-dropdown" id="manage-subject-delete-dropdown-wrap" style="width: 100%;">
              <button type="button" class="cyber-dropdown-trigger" id="manage-subject-delete-dropdown-trigger" onclick="App.toggleManageSubjectDeleteDropdown(event)" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-controls="manage-subject-delete-dropdown-menu">
                <span class="cyber-dropdown-icon" id="manage-subject-delete-dropdown-icon">📚</span>
                <span class="cyber-dropdown-label" id="manage-subject-delete-dropdown-label">Chọn môn chuyển sang...</span>
                <svg class="cyber-dropdown-chevron" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
