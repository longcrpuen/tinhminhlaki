    margin-bottom: 14px !important;
    width: 100% !important;
  }
  .lms-new-deck-fields {
    display: flex !important;
    flex-direction: column !important;
    gap: 14px !important;
    margin-bottom: 14px !important;
    width: 100% !important;
  }
  .lms-config-grid .form-group,
  .lms-new-deck-fields .form-group {
