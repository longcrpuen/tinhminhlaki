::-webkit-scrollbar-thumb:hover { background: var(--accent-border); }

/* ========== QUIZ OPTION TAILWIND UTILITIES ========== */
.items-start { align-items: flex-start !important; }
.gap-3 { gap: 0.75rem !important; }
.flex-shrink-0 { flex-shrink: 0 !important; }
.select-none { user-select: none !important; }
.mt-0\.5, .mt-0-5 { margin-top: 0.125rem !important; }
.break-words { overflow-wrap: break-word !important; word-break: normal !important; }
.h-auto { height: auto !important; }
.min-h-\[52px\] { min-height: 52px !important; }
.text-base { font-size: 1rem !important; }
.flex-1 { flex: 1 1 0% !important; }

/* ========== SELECTION ========== */
::selection { background: var(--accent-subtle-bg); color: var(--text-primary); }

/* ========== TASKS 3 & 4: MOBILE LANDSCAPE ERGONOMICS & ADAPTIVE SIDEBAR ========== */
@media (max-height: 550px), (orientation: landscape) and (max-height: 550px) {
  /* 1. Desktop sidebar remains hidden on constrained height mobile landscape */
  .app-sidebar {
    display: none !important;
  }

  /* 2. Adaptive Left Sidebar for non-quiz mobile landscape (< 1024px & height <= 500px) */
  body:not(.quiz-active) .bottom-nav {
    display: flex !important;
    position: fixed !important;
    left: 0 !important;
    top: 0 !important;
    bottom: 0 !important;
    right: auto !important;
    width: 64px !important; /* w-16 = 64px */
    height: 100% !important;
    flex-direction: column !important;
    padding: 8px 0 !important; /* py-2 */
    justify-content: flex-start !important;
    gap: 12px !important; /* space-y-3 */
    z-index: 50 !important;
    background: rgba(15, 14, 23, 0.95) !important; /* bg-[#0f0e17]/95 */
    border-right: 1px solid rgba(255, 255, 255, 0.1) !important; /* border-r border-white/10 */
    border-top: none !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
  }
  body:not(.quiz-active) .bottom-nav-item {
    width: 100% !important;
    min-height: 44px !important;
    padding: 6px 0 !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0 !important;
  }
  body:not(.quiz-active) .bottom-nav-item span {
    display: none !important; /* sleek icon-only sidebar */
  }
  body:not(.quiz-active) .bottom-nav-item svg {
    width: 22px !important;
    height: 22px !important;
    margin: auto !important;
  }
  body:not(.quiz-active) .app-main {
    margin-left: 64px !important; /* ml-16 */
    width: calc(100% - 64px) !important;
    max-width: calc(100% - 64px) !important;
    height: auto !important;
    min-height: 100dvh !important;
    max-height: none !important;
    overflow-y: auto !important;
    -webkit-overflow-scrolling: touch !important;
    padding-bottom: max(40px, env(safe-area-inset-bottom, 20px)) !important;
  }

  /* In quiz/exam mode, hide bottom nav to maximize focus and vertical screen real estate */
  body.quiz-active .bottom-nav {
    display: none !important;
  }
  body.quiz-active .app-main {
    margin-left: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
  }

  /* 3. Bulletproof Mode Isolation */
  #view-study:not(.active),
  #view-exam:not(.active),
  body.quiz-active #view-study:not(.active),
  body.quiz-active #view-exam:not(.active) {
    display: none !important;
  }

  /* 4. Natural Whole-Page Scroll in Quiz/Study session without clipping */
  html,
  body.quiz-active {
    height: auto !important;
    min-height: 100% !important;
    max-height: none !important;
    overflow-x: hidden !important;
    overflow-y: auto !important;
    -webkit-overflow-scrolling: touch !important;
  }

  body.quiz-active #view-study.active,
  body.quiz-active #view-exam.active {
    overflow: visible !important;
    overflow-y: visible !important;
    height: auto !important;
    min-height: 100% !important;
    max-height: none !important;
    display: flex !important;
    flex-direction: column !important;
  }
  body.quiz-active .content-wrapper {
    height: auto !important;
    min-height: 100% !important;
    max-height: none !important;
    overflow: visible !important;
    padding: 0 !important;
    margin: 0 !important;
    box-sizing: border-box !important;
  }
  body.quiz-active .app-main {
    height: auto !important;
    min-height: 100dvh !important;
    max-height: none !important;
    overflow-y: auto !important;
    overflow: visible !important;
    overscroll-behavior-y: contain !important;
    -webkit-overflow-scrolling: touch !important;
    padding-bottom: max(72px, env(safe-area-inset-bottom, 24px)) !important;
  }
  body.quiz-active .quiz-container,
  #view-study .quiz-container {
    height: auto !important;
    min-height: 100% !important;
    max-height: none !important;
    overflow: visible !important;
    padding: 8px 14px max(72px, env(safe-area-inset-bottom, 24px)) 14px !important;
  }
  body.quiz-active #study-quiz-area:not(.hidden-mode),
  #study-quiz-area {
    flex: none !important;
    height: auto !important;
    min-height: auto !important;
    max-height: none !important;
    overflow: visible !important;
    overflow-y: visible !important;
    overflow-x: visible !important;
    display: flex !important;
    flex-direction: column !important;
    width: 100% !important;
    padding-bottom: 0 !important;
    box-sizing: border-box !important;
  }
  body.quiz-active .quiz-card,
  #view-study .quiz-card {
    min-height: 100% !important;
    height: auto !important;
    max-height: none !important;
    overflow-y: auto !important;
    overscroll-behavior-y: contain !important;
    padding-bottom: 96px !important; /* pb-24 */
