/* ==========================================================================
   PART A, B, C: LMS IMPORT, NUMERIC QUESTIONS & SHUFFLED OPTIONS STYLES
   ========================================================================== */

/* --- Source & Review Badges --- */
.source-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.72rem;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 9999px;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}
.source-badge-lms {
  background: rgba(168, 85, 247, 0.18);
  color: #c084fc;
  border: 1px solid rgba(168, 85, 247, 0.35);
}
.source-badge-ai {
  background: rgba(59, 130, 246, 0.18);
  color: #60a5fa;
  border: 1px solid rgba(59, 130, 246, 0.35);
}
.source-badge-manual {
  background: rgba(148, 163, 184, 0.18);
  color: #94a3b8;
  border: 1px solid rgba(148, 163, 184, 0.3);
}
.badge-review-flag {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.72rem;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 9999px;
  background: rgba(239, 68, 68, 0.18);
  color: #f87171;
  border: 1px solid rgba(239, 68, 68, 0.4);
}
.badge-review-flag:hover {
  animation: pulse-soft 2s infinite ease-in-out;
}
@keyframes pulse-soft {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.75; }
}

/* Question Bank Review Filter Active */
#bank-filter-review.active {
  background: rgba(239, 68, 68, 0.25);
  border-color: #ef4444;
  color: #fca5a5;
  box-shadow: 0 0 12px rgba(239, 68, 68, 0.3);
}

.bank-source-filter {
  min-width: 140px;
  padding: 8px 12px;
  font-size: 0.85rem;
  background: var(--bg-surface-elevated);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  border-radius: var(--radius-md);
  cursor: pointer;
}

/* --- LMS Import Preview Cards --- */
.lms-preview-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-top: 16px;
}
.lms-preview-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 18px 20px;
  transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  box-shadow: var(--shadow-sm);
  content-visibility: auto;
  contain-intrinsic-size: 0 200px;
  contain-intrinsic-block-size: auto 200px;
  contain: layout style paint;
}
.lms-preview-card:hover {
  border-color: rgba(168, 85, 247, 0.4);
}
.lms-preview-card.needs-review {
  border-color: rgba(239, 68, 68, 0.45);
  background: linear-gradient(180deg, rgba(239, 68, 68, 0.04) 0%, var(--bg-surface) 100%);
}
.lms-preview-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  flex-wrap: wrap;
  gap: 8px;
}
.lms-card-badges {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.lms-card-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}
.lms-type-select {
  padding: 4px 10px;
  font-size: 0.8rem;
  border-radius: var(--radius-sm);
  background: var(--bg-surface-elevated);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  cursor: pointer;
}
.lms-card-delete-btn {
  background: transparent;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px 8px;
  border-radius: var(--radius-sm);
  transition: color var(--dur-fast), background var(--dur-fast);
}
.lms-card-delete-btn:hover {
  color: #ef4444;
  background: rgba(239, 68, 68, 0.12);
}

.lms-question-edit-box {
  width: 100%;
  font-family: inherit;
  font-size: 0.92rem;
  padding: 10px 14px;
  background: var(--bg-surface-elevated);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  resize: vertical;
  min-height: 60px;
  margin-bottom: 12px;
  transition: border-color var(--dur-fast);
}
.lms-question-edit-box:focus {
  border-color: var(--accent);
  outline: none;
  box-shadow: 0 0 0 2px rgba(168, 85, 247, 0.2);
}

.lms-options-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 12px;
}
.lms-option-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 12px;
  border-radius: var(--radius-md);
  background: var(--bg-surface-elevated);
  border: 1px solid var(--border-color);
  transition: border-color var(--dur-fast), background var(--dur-fast);
}
.lms-option-row.is-correct {
  border-color: #10b981;
  background: rgba(16, 185, 129, 0.08);
}
.lms-option-radio {
  cursor: pointer;
  accent-color: #10b981;
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}
.lms-option-letter {
  font-weight: 700;
  font-size: 0.85rem;
  min-width: 24px;
  color: var(--text-secondary);
  text-transform: uppercase;
}
.lms-option-row.is-correct .lms-option-letter {
  color: #10b981;
}
.lms-option-text-input {
  flex: 1;
  background: transparent;
  border: none;
  color: var(--text-primary);
  font-size: 0.88rem;
  font-family: inherit;
  outline: none;
}

/* Numeric Configuration inside LMS Card */
.lms-numeric-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  border-radius: var(--radius-md);
  background: var(--bg-surface-elevated);
  border: 1px dashed var(--border-color);
  margin-bottom: 12px;
}
.lms-numeric-input {
  flex: 1;
  padding: 8px 12px;
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
  font-size: 0.95rem;
  font-family: inherit;
}
.lms-numeric-input:focus {
  border-color: var(--accent);
  outline: none;
}

/* Explanation, Topic & Difficulty inputs in LMS Card */
.lms-meta-row {
  display: grid;
  grid-template-columns: 1fr 1fr 2fr;
  gap: 10px;
}

/* --- PART B: NUMERIC QUIZ & EXAM COMPONENT --- */
.quiz-numeric-box {
  width: 100%;
  margin: 16px 0;
}
.numeric-input-card {
  background: var(--bg-surface-elevated);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-shadow: var(--shadow-sm);
}
.numeric-label {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: 6px;
}
.numeric-input-row {
  display: flex;
  gap: 12px;
  align-items: center;
}
.numeric-input {
  flex: 1;
  padding: 12px 16px;
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  background: var(--bg-surface);
  border: 2px solid var(--border-color);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
}
.numeric-input:focus {
  border-color: var(--accent);
  outline: none;
  box-shadow: 0 0 16px rgba(168, 85, 247, 0.25);
}
.btn-numeric-submit {
  padding: 12px 24px;
  font-size: 0.95rem;
  font-weight: 600;
  white-space: nowrap;
}
.numeric-feedback {
  padding: 12px 16px;
  border-radius: var(--radius-md);
  font-size: 0.95rem;
  font-weight: 600;
  line-height: 1.5;
  animation: fadeIn 0.2s ease-out;
}
.numeric-feedback.correct {
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid #10b981;
  color: #10b981;
}
.numeric-feedback.incorrect {
  background: rgba(239, 68, 68, 0.15);
  border: 1px solid #ef4444;
  color: #f87171;
}

