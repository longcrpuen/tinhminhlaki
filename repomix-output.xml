              <svg class="cyber-dropdown-chevron" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="cyber-dropdown-menu" id="edit-card-correct-dropdown-menu" style="width: 100%; min-width: 100%; box-sizing: border-box;">
              <button type="button" class="cyber-dropdown-item active" onclick="App.selectEditCardCorrect('a')">
                <span>Đáp án A</span>
              </button>
              <button type="button" class="cyber-dropdown-item" onclick="App.selectEditCardCorrect('b')">
                <span>Đáp án B</span>
              </button>
              <button type="button" class="cyber-dropdown-item" onclick="App.selectEditCardCorrect('c')">
                <span>Đáp án C</span>
              </button>
              <button type="button" class="cyber-dropdown-item" onclick="App.selectEditCardCorrect('d')">
                <span>Đáp án D</span>
              </button>
            </div>
          </div>
          <select id="edit-card-correct" class="form-control" style="display: none;">
            <option value="a">A</option>
            <option value="b">B</option>
            <option value="c">C</option>
            <option value="d">D</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="edit-card-explanation">
            Giải thích chi tiết: <span style="font-size: 0.78rem; color: var(--text-muted);">(Hỗ trợ công thức LaTeX $...$)</span>
          </label>
          <textarea id="edit-card-explanation" class="form-control" rows="2" placeholder="Giải thích vì sao đáp án đúng..."></textarea>
        </div>

        <!-- Live Preview Toggle & Box -->
        <div style="margin-top: 12px; margin-bottom: 8px;">
          <button type="button" class="btn btn-secondary" style="font-size: 0.8rem; padding: 4px 10px;" onclick="App.toggleEditCardPreview()">
            👁️ Xem trước công thức LaTeX
          </button>
        </div>
        <div id="edit-card-preview-box" style="display: none; padding: 12px; border-radius: var(--radius-md); background: var(--bg-surface-elevated); border: 1px solid var(--border-color); font-size: 0.9rem;">
          <div id="edit-card-preview-content"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary modal-close">Hủy</button>
        <button class="btn btn-primary" onclick="App.saveCardEdit()">💾 Lưu thay đổi</button>
      </div>
    </div>
  </div>

  <!-- MODAL: Create New Subject -->
  <div id="modal-create-subject" class="modal-overlay">
    <div class="modal-box" style="max-width: 480px;">
      <div class="modal-header">
        <h3 class="modal-title">➕ Tạo Môn Học Mới</h3>
        <button class="icon-btn modal-close" style="width: 32px; height: 32px;">✕</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label" for="create-subject-name">Tên môn học (bắt buộc):</label>
          <input type="text" id="create-subject-name" class="form-control" placeholder="Ví dụ: Toán Học, Triết Học, Lập Trình...">
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
          <div class="form-group">
            <label class="form-label" for="create-subject-icon">Biểu tượng (Emoji):</label>
