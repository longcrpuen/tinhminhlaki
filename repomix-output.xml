.cyber-input::placeholder,
input::placeholder,
textarea::placeholder,
.cyber-textarea::placeholder {
  color: var(--text-muted);
  opacity: 0.75;
}
.form-control:focus,
.cyber-input:focus,
input[type="text"]:focus,
input[type="number"]:focus,
input[type="url"]:focus,
input[type="password"]:focus,
input[type="search"]:focus,
select:focus,
textarea:focus,
.cyber-textarea:focus {
  outline: none;
  border-color: var(--border-focus);
  box-shadow: var(--border-focus-glow);
}
select.form-control option,
select option {
  background-color: #0d0e15;
  color: #f8f6fd;
}
textarea.form-control,
.cyber-textarea,
textarea {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  min-height: 180px;
  resize: vertical;
  border-radius: var(--radius-card-sm);
  padding: 14px 18px;
}

/* ========== MODAL — High FPS, 0% GPU Thrashing (No full-screen blur) ========== */
.modal-overlay {
  position: fixed; inset: 0;
  background: rgba(9, 10, 15, 0.88);
  display: none; place-items: center;
  z-index: 1000; padding: 20px;
  transform: translateZ(0);
  will-change: opacity;
}
.modal-overlay.show {
  display: grid;
  animation: modalFadeIn var(--dur-norm) var(--ease-out-soft);
}
@keyframes modalFadeIn { 0% { opacity: 0; } 100% { opacity: 1; } }

/* Pause background gradient drifting when any modal is open to eliminate background GPU draw */
body.modal-open::before,
body.modal-open::after,
body.modal-open .hero-card::before {
  animation-play-state: paused !important;
}

body.disable-backdrop-blur .modal-overlay,
body.disable-backdrop-blur .app-sidebar,
body.disable-backdrop-blur .app-topbar {
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

.modal-box {
  background: rgba(18, 16, 28, 0.98);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-top-color: rgba(255, 255, 255, 0.16);
  border-radius: var(--radius-card-lg);
  max-width: 680px; width: 100%;
  max-height: calc(100vh - 48px);
  max-height: calc(100dvh - 48px);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 24px 48px rgba(0,0,0,0.65), 0 0 28px rgba(167, 139, 250, 0.16), inset 0 1px 0 rgba(255,255,255,0.08);
  transform: translateZ(0);
  will-change: transform, opacity;
  animation: modalFadeUp var(--dur-norm) var(--ease-out-soft);
}
@keyframes modalFadeUp {
  0%   { opacity: 0; transform: translateY(12px) scale(0.98); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

.modal-header {
  display: flex; align-items: center;
  justify-content: space-between;
  padding: 20px 24px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
  flex-shrink: 0;
  box-sizing: border-box;
}
.modal-title { font-size: 1.2rem; font-weight: 700; color: #ede9f6; }
.modal-body {
  padding: 24px;
  flex: 1 1 auto;
  overflow-y: auto;
  overflow-x: hidden;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
}
/* ========== LIQUID GLASS CELEBRATION EFFECT (Replaces heavy particle confetti) ========== */
.liquid-celebration-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 12px 0 24px 0;
}

/* Concentric Liquid Ripple Rings (Super lightweight GPU transform/opacity only) */
.liquid-ripple-ring {
  position: absolute;
  width: 140px;
  height: 140px;
  border-radius: 50%;
  border: 2px solid rgba(167, 139, 250, 0.40);
  background: radial-gradient(circle, rgba(167, 139, 250, 0.12) 0%, transparent 70%);
  pointer-events: none;
  opacity: 0;
  transform: scale(0.6);
}
.liquid-celebration-wrap.animate .liquid-ripple-ring:nth-child(1) {
  animation: liquidRipple 2.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
.liquid-celebration-wrap.animate .liquid-ripple-ring:nth-child(2) {
  animation: liquidRipple 2.2s cubic-bezier(0.16, 1, 0.3, 1) 0.35s forwards;
}
.liquid-celebration-wrap.animate .liquid-ripple-ring:nth-child(3) {
  animation: liquidRipple 2.2s cubic-bezier(0.16, 1, 0.3, 1) 0.7s forwards;
}
@keyframes liquidRipple {
  0% {
    opacity: 0.85;
    transform: scale(0.5);
  }
  50% {
    opacity: 0.45;
  }
  100% {
    opacity: 0;
    transform: scale(2.3);
  }
}

/* Liquid Glass Orb / Vessel with Rising Fluid */
.liquid-glass-orb {
  position: relative;
  width: 136px;
  height: 136px;
  border-radius: 50%;
  background: rgba(26, 22, 40, 0.88);
  border: 2px solid rgba(167, 139, 250, 0.35);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45), inset 0 2px 4px rgba(255, 255, 255, 0.15), 0 0 24px var(--accent-glow);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.liquid-glass-orb::before {
  content: '';
  position: absolute;
  top: 6px;
  left: 20px;
  right: 20px;
  height: 28px;
  border-radius: 50%;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.25), transparent);
  pointer-events: none;
  z-index: 4;
}

/* Rising Liquid Level with subtle wave */
.liquid-fill-level {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 0%;
  background: linear-gradient(180deg, #c084fc 0%, #a78bfa 40%, #7c3aed 100%);
  transition: height 1.2s cubic-bezier(0.34, 1.2, 0.64, 1);
  box-shadow: 0 0 18px rgba(167, 139, 250, 0.6);
  z-index: 1;
}
.liquid-fill-level::before {
  content: '';
  position: absolute;
  top: -6px;
  left: -20%;
  width: 140%;
  height: 12px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  filter: blur(1px);
  animation: liquidWaveShift 3s ease-in-out infinite alternate;
}
@keyframes liquidWaveShift {
  0% { transform: translateX(-8px) scaleY(0.8); }
  100% { transform: translateX(8px) scaleY(1.2); }
}

.liquid-score-value {
  position: relative;
  z-index: 5;
  font-size: 2.3rem;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
  letter-spacing: -0.02em;
}

.modal-footer {
  display: flex; justify-content: flex-end; gap: 12px;
  padding: 16px 24px;
  border-top: 1px solid rgba(255,255,255,0.08);
  background: rgba(22, 19, 36, 0.98);
  flex-shrink: 0;
  box-sizing: border-box;
}

/* ========== TOAST — ALWAYS DARK ========== */
.toast-container {
  position: fixed; bottom: 24px; right: 24px;
  display: flex; flex-direction: column; gap: 10px;
  z-index: 10000; pointer-events: none;
}
.toast {
  background: #221e36;
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius-md);
  padding: 12px 20px;
  color: #ede9f6; font-size: 0.9rem; font-weight: 500;
  box-shadow: 0 6px 20px rgba(0,0,0,0.40);
  display: flex; align-items: center; gap: 10px;
  animation: toastBounceIn var(--dur-norm) var(--ease-spring);
  pointer-events: auto;
}
@keyframes toastBounceIn {
  0%   { transform: translateY(20px) scale(0.96); opacity: 0; }
  60%  { transform: translateY(-3px) scale(1.015); opacity: 1; }
  100% { transform: translateY(0) scale(1); opacity: 1; }
}

/* ========== BOTTOM NAV (mobile) ========== */
.bottom-nav {
  display: none;
  position: fixed; bottom: 0; left: 0; right: 0;
  background: rgba(18, 19, 26, 0.95);
  border-top: 1px solid var(--border-color);
  padding: 6px 12px;
  z-index: 100;
  justify-content: space-around;
  min-height: 56px;
  transform: translateZ(0);
}
.bottom-nav-item {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 4px;
  background: transparent; border: none;
  color: var(--text-secondary);
  font-size: 0.72rem; font-weight: 500;
  cursor: pointer;
  padding: 6px 10px;
  min-height: 44px; min-width: 44px;
  border-radius: var(--radius-sm);
  transition: color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-spring);
}
.bottom-nav-item:active { transform: scale(0.90, 1.05); }
.bottom-nav-item.active { color: var(--accent); font-weight: 700; }
.bottom-nav-item svg { width: 22px; height: 22px; }

/* ========== RESPONSIVE ========== */
@media (max-width: 840px) {
  .app-sidebar { display: none !important; }
  .app-main { margin-left: 0 !important; width: 100% !important; max-width: 100% !important; padding-bottom: 84px; }
  .bottom-nav { display: flex; }
  .hero-content { flex-direction: column; align-items: stretch; gap: 24px; }
  .content-wrapper { padding: 20px 16px; }
  .srs-ratings-bar { grid-template-columns: repeat(2, 1fr); }
  .daily-radial-card { width: 100%; justify-content: center; }
  .study-modes-grid { grid-template-columns: repeat(2, 1fr); }
  .stats-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 12px; }
}

