  margin-bottom: 0;
  flex: 0 1 auto !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: flex-start !important;
  min-height: 0 !important;
  overflow: hidden !important;
  width: 100%;
  box-sizing: border-box;
  position: relative;
}

#view-study .quiz-card .blind-recall-box {
  max-height: 240px;
  flex: 0 1 auto;
  margin: 12px 0 0 0 !important;
  width: 100% !important;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.blind-recall-box {
  max-height: 240px;
  flex: 0 1 auto;
  margin: 12px 0 0 0 !important;
  width: 100% !important;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.quiz-card.blind-active {
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
  flex: none !important;
  padding-bottom: 20px !important;
  margin-bottom: 0 !important;
  box-sizing: border-box !important;
}

#view-study .quiz-card.blind-active,
body.quiz-active .quiz-card.blind-active,
body.quiz-blind-active .quiz-card {
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
  flex: none !important;
  padding-bottom: 20px !important;
  margin-bottom: 0 !important;
