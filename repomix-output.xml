              <span class="cyber-dropdown-icon" id="bulk-reassign-subject-dropdown-icon">📚</span>
              <span class="cyber-dropdown-label" id="bulk-reassign-subject-dropdown-label">Chọn môn học đích...</span>
              <svg class="cyber-dropdown-chevron" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="cyber-dropdown-menu" id="bulk-reassign-subject-dropdown-menu" role="listbox" style="width: 100%; min-width: 100%; box-sizing: border-box;">
