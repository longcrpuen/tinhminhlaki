  .lms-config-grid .form-label,
  .lms-new-deck-fields .form-label,
  .lms-raw-input-group .form-label {
    display: block !important;
    margin-bottom: 6px !important;
    font-size: 0.88rem !important;
    font-weight: 600 !important;
    white-space: normal !important;
    width: 100% !important;
    text-align: left !important;
  }
  .lms-config-grid .form-control,
  .lms-new-deck-fields .form-control,
  .lms-config-grid .cyber-dropdown-trigger {
    width: 100% !important;
