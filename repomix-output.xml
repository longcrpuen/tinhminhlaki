  color: var(--accent);
  box-shadow: 0 0 16px var(--accent-glow);
}

/* ========== BACKGROUND PICKER GRID & THUMBNAILS (16:9 STANDARD) ========== */
.bg-picker-grid {
  display: grid !important;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)) !important;
  gap: 14px !important;
  margin-bottom: 16px !important;
  align-items: start !important;
}

.bg-thumb {
  position: relative !important;
  width: 100% !important;
  aspect-ratio: 16 / 9 !important;
  height: auto !important;
  border-radius: var(--radius-md, 14px) !important;
  border: 2px solid var(--border-color) !important;
  box-sizing: border-box !important;
  overflow: hidden !important;
  cursor: pointer !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  background-color: var(--bg-surface-elevated) !important;
  transition: transform var(--dur-fast) var(--ease-spring), border-color var(--dur-fast) ease, box-shadow var(--dur-fast) ease !important;
  transform: translateZ(0);
}

.bg-thumb:hover {
  border-color: var(--border-focus) !important;
  transform: translateY(-2px) !important;
}

.bg-thumb.active {
  border-color: var(--accent) !important;
  box-shadow: 0 0 16px var(--accent-glow) !important;
}

.bg-thumb img {
  position: absolute !important;
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  object-position: center !important;
  display: block !important;
  border: none !important;
  padding: 0 !important;
  margin: 0 !important;
  z-index: 1 !important;
}

.bg-thumb-none {
  background: var(--bg-surface) !important;
}

.bg-thumb-none-icon {
  font-size: 1.5rem !important;
  line-height: 1 !important;
  z-index: 1 !important;
  margin-bottom: 8px !important;
  pointer-events: none !important;
}

.bg-thumb-label {
  position: absolute !important;
  bottom: 0 !important;
  left: 0 !important;
  right: 0 !important;
  width: 100% !important;
  box-sizing: border-box !important;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.90) 0%, rgba(0, 0, 0, 0.55) 60%, transparent 100%) !important;
  color: #ffffff !important;
  font-size: 0.72rem !important;
  font-weight: 600 !important;
  padding: 12px 6px 5px 6px !important;
  text-align: center !important;
  white-space: nowrap !important;
  overflow: hidden !important;
