/* ========== FLASHCARD COMPONENT (REWRITTEN) ========== */
.flashcard-player-container {
  width: 100%;
  max-width: 680px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 14px;
  box-sizing: border-box;
}
.flashcard-stage {
  perspective: 1200px;
  -webkit-perspective: 1200px;
  width: 100%;
  height: 320px;
  min-height: 280px;
  max-height: 340px;
  display: flex;
  flex-direction: column;
  flex: none;
  margin-bottom: 0;
}
.flashcard-card {
  width: 100%;
  height: 100%;
  min-height: 0;
  max-height: 340px;
  flex: none;
  position: relative;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  user-select: none;
  border-radius: var(--radius-card, 20px);
}
.flashcard-card.flipped {
  transform: rotateY(180deg);
  -webkit-transform: rotateY(180deg);
}
.flashcard-card.flipped .flashcard-front {
  z-index: 1 !important;
  pointer-events: none;
}
.flashcard-card.flipped .flashcard-back {
  z-index: 3 !important;
  pointer-events: auto;
}
.flashcard-face {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  border-radius: var(--radius-card, 20px);
  border: 1px solid var(--glass-border);
  background: var(--glass-tint, rgba(22, 21, 34, 0.92));
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  padding: 20px 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: inset 0 1px 0 var(--glass-highlight), var(--shadow-lg);
  box-sizing: border-box;
  overflow: hidden;
}
.flashcard-front {
  transform: rotateY(0deg);
  -webkit-transform: rotateY(0deg);
  z-index: 2;
}
.flashcard-back {
  transform: rotateY(180deg);
  -webkit-transform: rotateY(180deg);
  background: var(--bg-surface-elevated, #1a1829);
  border-color: rgba(168, 85, 247, 0.35);
  z-index: 1;
}
.flashcard-face-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  gap: 8px;
  margin-bottom: 8px;
}
.flashcard-tags {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}
.flashcard-tag-back {
  font-size: 0.75rem;
  font-weight: 700;
  color: #10b981;
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid rgba(16, 185, 129, 0.3);
  padding: 3px 10px;
  border-radius: var(--radius-full);
}
.flashcard-flip-badge {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--accent);
  opacity: 0.85;
}
.flashcard-content-wrap {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 8px 0;
  word-break: break-word;
  touch-action: pan-y;
  text-align: center;
}
.flashcard-question-text {
  font-size: clamp(1.08rem, 2.2vw, 1.35rem);
  font-weight: 600;
  line-height: 1.55;
  color: var(--text-primary);
  margin: 0;
}
.flashcard-answer-label {
  font-size: 0.75rem;
  font-weight: 700;
  color: #10b981;
  letter-spacing: 0.08em;
  margin-bottom: 6px;
}
.flashcard-answer-text {
  font-size: clamp(1.15rem, 2.4vw, 1.45rem);
  font-weight: 800;
  line-height: 1.45;
  color: #10b981;
  margin: 0 0 10px 0;
}
.flashcard-explanation-box {
  margin-top: 10px;
  padding: 10px 14px;
  border-radius: var(--radius-md, 12px);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  text-align: left;
}
.flashcard-explanation-header {
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--accent);
  margin-bottom: 4px;
}
.flashcard-explanation-text {
  font-size: 0.85rem;
  line-height: 1.5;
  color: var(--text-secondary);
  margin: 0;
  overflow-wrap: break-word;
}
.flashcard-exp-toggle-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 6px;
  padding: 3px 10px;
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--accent);
  background: rgba(168, 85, 247, 0.12);
  border: 1px solid rgba(168, 85, 247, 0.28);
  border-radius: var(--radius-full, 9999px);
  cursor: pointer;
  transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease;
}
.flashcard-exp-toggle-btn:hover {
  background: rgba(168, 85, 247, 0.22);
  border-color: rgba(168, 85, 247, 0.45);
}
.flashcard-explanation-box.is-collapsible:not(.is-expanded) .flashcard-explanation-text {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}
.flashcard-explanation-box.is-collapsible.is-expanded {
  max-height: 120px;
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
}
.flashcard-explanation-box.is-collapsible.is-expanded .flashcard-explanation-text {
  display: block;
  -webkit-line-clamp: unset;
  line-clamp: unset;
}
.flashcard-hint {
  display: none !important;
}
.flashcard-hint-back {
  display: none !important;
}
.flashcard-bottom-actions {
  width: 100%;
  flex-shrink: 0;
}
#btn-flashcard-reveal,
.btn-flashcard-reveal {
  display: none !important;
  visibility: hidden !important;
  pointer-events: none !important;
  height: 0 !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
}

