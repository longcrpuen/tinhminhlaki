  align-items: center;
  justify-content: center;
  color: var(--accent-bright);
}

.study-mode-card:hover .study-mode-icon-well {
  border-color: rgba(244, 114, 182, 0.5);
  color: #f472b6;
  box-shadow: 0 0 10px rgba(244, 114, 182, 0.3);
}

.study-mode-title {
  margin: 0 0 8px 0;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.01em;
}

.study-mode-desc {
  margin: 0 0 18px 0;
  font-size: 0.85rem;
  line-height: 1.5;
  color: var(--text-secondary);
}

.study-mode-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: auto;
}

.study-mode-pill-btn {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #d4d4d8;
  border-radius: 9999px;
  padding: 6px 14px;
  font-size: 0.8rem;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: all 0.2s ease;
}

.study-mode-pill-btn .arrow {
  display: inline-block;
  transition: transform 0.2s ease;
}

.study-mode-card:hover .study-mode-pill-btn {
  background: #7c3aed !important;
  color: #ffffff !important;
  font-weight: 700 !important;
  box-shadow: 0 4px 14px rgba(124, 58, 237, 0.55);
  border-color: rgba(255, 255, 255, 0.25);
}

.study-mode-card:hover .study-mode-pill-btn .arrow {
  transform: translateX(4px);
}

/* --------------------------------------------------------------------------
   6. THƯ VIỆN BỘ CÂU HỎI & MÔN HỌC (#view-decks)
   -------------------------------------------------------------------------- */
.subject-group {
  margin-bottom: 22px;
  overflow: hidden;
}

.subject-group-header {
  padding: 16px 22px !important;
  background: rgba(30, 20, 54, 0.9) !important;
  border-bottom: 1px solid rgba(192, 132, 252, 0.18) !important;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  cursor: pointer;
  user-select: none;
}

.subject-group-title {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.subject-badge {
  background: var(--bg-well) !important;
  border: 1px solid rgba(192, 132, 252, 0.20) !important;
  border-radius: 9999px;
  padding: 2px 10px;
  font-size: 0.72rem;
  font-family: var(--font-mono, monospace);
  color: var(--text-secondary);
}

.subject-group-body {
  padding: 20px !important;
}

.deck-card {
  padding: 20px !important;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 16px;
}

.deck-name {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text-primary);
  margin: 0 0 6px 0;
}

.deck-desc {
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.45;
  margin: 0;
}

.deck-meta {
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 0.78rem;
  font-family: var(--font-mono, monospace);
  color: var(--text-muted);
  margin-bottom: 12px;
}

.deck-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

/* --------------------------------------------------------------------------
   7. DATAMOSH GLITCH & QUOTE REFRESH ANIMATION (HIGH PERFORMANCE 120 FPS)
   -------------------------------------------------------------------------- */
.datamosh-active {
  animation: datamosh-pulse 0.32s cubic-bezier(0.25, 1, 0.5, 1) forwards !important;
  transform-origin: center center;
  will-change: transform, opacity;
}

@keyframes datamosh-pulse {
  0% {
    transform: scale(1) skewX(-1.5deg);
    opacity: 0.85;
  }
  25% {
    transform: scale(1.02) skewX(2deg) translateY(-1px);
    opacity: 0.95;
  }
  50% {
    transform: scale(0.99) skewX(-1deg);
    opacity: 0.9;
  }
  75% {
    transform: scale(1.01) skewX(0.5deg);
    opacity: 1;
  }
  100% {
    transform: scale(1) skewX(0deg);
    opacity: 1;
  }
}
