<file path="css/style.css">
/* ===================================================
   MindSparks Design System v4.0 — Pixel Garden
   =================================================== */

@import url('./theme.css');
@import url('./fonts.css');
@import url('../lib/katex/katex.min.css');

/* ========== THEME: Single Dark Mode (Imported from theme.css) ========== */
:root,
html,
body {
  color-scheme: dark;
}

/* ========== BASE RESET ========== */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-family: var(--font-family);
  background-color: var(--bg-base);
  color: var(--text-primary);
  min-height: 100vh;
  min-height: 100dvh;
  line-height: 1.55;
  letter-spacing: -0.025em;
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent;
  overflow-x: hidden;
  overflow-x: clip;
  max-width: 100%;
  width: 100%;
  box-sizing: border-box;
}

*, *:before, *:after {
  box-sizing: inherit;
}

body {
  font-family: inherit;
  background-color: var(--bg-base);
  color: inherit;
  min-height: 100vh;
  min-height: 100dvh;
  letter-spacing: -0.025em;
  overflow-x: hidden;
  overflow-x: clip;
  max-width: 100%;
  width: 100%;
}

hr {
  box-sizing: border-box !important;
  max-width: 100% !important;
  width: 100% !important;
}

/* ========== BACKGROUND LAYER (fixed behind everything) ========== */
#bg-layer {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background-color: #0c0915;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  opacity: 0;
  transition: opacity 0.4s ease;
  will-change: opacity;
  transform: translateZ(0);
}

/* Dreamy Purple Duotone Overlay (mix-blend-mode: multiply/overlay) */
/* mix-blend-mode: multiply; */
#bg-layer::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(16, 8, 30, 0.82) 0%, rgba(38, 12, 62, 0.70) 50%, rgba(10, 7, 18, 0.92) 100%);
  mix-blend-mode: normal;
  z-index: 1;
}

/* Ambient glow and subtle contrast gradient */
#bg-layer::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 65% 20%, rgba(192, 132, 252, 0.28) 0%, transparent 60%),
              linear-gradient(to bottom, rgba(12, 9, 21, 0.35) 0%, rgba(12, 9, 21, 0.82) 100%);
  z-index: 2;
  pointer-events: none;
}

#bg-layer.active {
  opacity: 1;
}

body.has-custom-bg {
  background-color: transparent !important;
}

/* Ambient single subtle glowing spot (radial-gradient tím dạ quang độ mờ 15% - Zero FPS drop) */
body::before {
  content: '';
  position: fixed;
  top: 15%;
  left: 50%;
  transform: translate(-50%, -20%) translateZ(0);
  width: 760px;
  height: 520px;
  max-width: 92vw;
  background: radial-gradient(ellipse at center, rgba(168, 85, 247, 0.15) 0%, rgba(124, 58, 237, 0.08) 45%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
  /* will-change: opacity; */
}

body::after {
  display: none !important;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Pause all animations when browser tab is inactive / hidden */
body.tab-hidden *,
body.tab-hidden *::before,
body.tab-hidden *::after {
  animation-play-state: paused !important;
}

/* ===================================================
   STANDARDIZED SHARED COMPONENTS (PHASE 0 FOUNDATION)
   =================================================== */

/* ========== 1. GLASS CARD & CARD BASE (no backdrop-filter!) ========== */
.glass-card,
.card-base {
  background: var(--glass-tint);
  border: 1px solid var(--glass-border);
  border-top-color: var(--glass-highlight);
  box-shadow:
    inset 0 1px 0 var(--glass-highlight),
    var(--shadow-sm);
  border-radius: var(--radius-card);
  position: relative;
  overflow: hidden;
  transition: transform var(--dur-norm) var(--ease-spring),
              box-shadow var(--dur-norm) var(--ease-out-soft),
              border-color var(--dur-norm) ease;
}
.glass-card:hover,
.card-base:hover {
  border-color: var(--accent-border);
  box-shadow: inset 0 1px 0 var(--glass-highlight), var(--card-hover-glow);
}

/* Light refraction sweep */
.glass-card::after,
.card-base::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 60%;
  height: 100%;
  background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.025) 45%, rgba(255,255,255,0.05) 50%, transparent 55%);
  animation: glassRefract 1.5s var(--ease-out-soft) forwards;
  pointer-events: none;
  z-index: 1;
}

@keyframes glassRefract {
  0%   { transform: translateX(-200%); opacity: 0; }
  30%  { opacity: 1; }
  100% { transform: translateX(320%); opacity: 0; }
}

/* ========== 2. BADGES & TAGS ========== */
.badge,
.tag,
.tech-tag {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: inherit;
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: var(--tracking-wide);
  padding: 3px 10px;
  border-radius: var(--radius-full);
  background: var(--accent-subtle-bg);
  border: 1px solid var(--accent-border);
  color: var(--accent);
  line-height: 1.25;
  user-select: none;
  white-space: nowrap;
}
.badge-accent,
.tag-accent {
  background: var(--accent-subtle-bg);
  border-color: var(--accent-border);
  color: var(--accent);
}
.badge-success,
.tag-success {
  background: var(--success-bg);
  border-color: var(--success-border);
  color: var(--success);
}
.badge-danger,
.tag-danger {
  background: var(--danger-bg);
  border-color: var(--danger-border);
  color: var(--danger);
}
.badge-warning,
.tag-warning {
  background: var(--warning-bg);
  border-color: var(--warning-border);
  color: var(--warning);
}
.badge-subtle,
.tag-subtle,
.tech-tag.subtle {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.10);
  color: var(--text-secondary);
}

/* ========== 3. TAB NAVIGATION & PILLS ========== */
.tab-nav {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-1);
  background: rgba(18, 19, 26, 0.7);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-full);
  box-sizing: border-box;
}
.tab-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  min-height: 40px;
  padding: 8px 18px;
  border-radius: var(--radius-full);
  color: var(--text-secondary);
  font-family: inherit;
  font-size: var(--text-sm);
  font-weight: 600;
  border: 1px solid transparent;
  background: transparent;
  cursor: pointer;
  text-decoration: none;
  white-space: nowrap;
  user-select: none;
  transition: all var(--dur-fast) ease;
}
.tab-pill:hover {
  color: var(--text-primary);
  background: rgba(167, 139, 250, 0.08);
}
.tab-pill.active {
  background: var(--accent-subtle-bg);
  color: var(--text-primary);
  border-color: var(--accent-border);
  box-shadow: 0 0 12px var(--accent-glow);
}
.tab-pill:focus-visible {
  outline: none;
  box-shadow: var(--focus-ring);
}

/* ========== 4. EMPTY STATES ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: var(--space-10) var(--space-6);
  gap: var(--space-4);
  min-height: 240px;
  border: 1px dashed var(--border-color);
  border-radius: var(--radius-card);
  background: rgba(18, 19, 26, 0.4);
  box-sizing: border-box;
}
.empty-state-icon {
  font-size: 2.8rem;
  line-height: 1;
  color: var(--accent);
  opacity: 0.9;
  filter: drop-shadow(0 0 14px var(--accent-glow));
}
.empty-state-title {
  font-family: var(--font-heading);
  font-size: var(--text-h3);
  color: var(--text-primary);
  font-weight: 700;
  letter-spacing: var(--tracking-pixel);
  margin: 0;
}
.empty-state-desc {
  font-size: var(--text-sm);
  color: var(--text-muted);
  max-width: 440px;
  line-height: var(--leading-normal);
  margin: 0;
}
.empty-state-actions {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-top: var(--space-2);
  flex-wrap: wrap;
  justify-content: center;
}

/* ========== 5. SKELETON LOADERS (GPU-FRIENDLY, ZERO LAYOUT SHIFT) ========== */
.skeleton {
  background: linear-gradient(
    90deg,
    rgba(28, 29, 38, 0.6) 25%,
    rgba(46, 43, 64, 0.75) 50%,
    rgba(28, 29, 38, 0.6) 75%
  );
  background-size: 200% 100%;
  animation: skeletonShimmer 1.8s ease-in-out infinite;
  border-radius: var(--radius-sm);
  pointer-events: none;
  display: block;
}
@keyframes skeletonShimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
.skeleton-text {
  height: 1em;
  width: 100%;
  border-radius: var(--radius-xs);
  margin: 4px 0;
}
.skeleton-circle {
  border-radius: 50%;
  flex-shrink: 0;
}
.skeleton-card {
  border-radius: var(--radius-card);
  height: 160px;
  width: 100%;
}
.skeleton-btn {
  height: 44px;
  border-radius: var(--radius-full);
  width: 120px;
}

/* ========== APP SHELL ========== */
.app-container {
  display: flex;
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* Sidebar — static alpha channel rgba(18, 19, 26, 0.85), no backdrop-filter to prevent scroll lag */
.app-sidebar {
  width: var(--sidebar-width);
  min-width: var(--sidebar-width);
  background: rgba(18, 19, 26, 0.85);
  border-right: 1px solid var(--border-color);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0; bottom: 0; left: 0;
  z-index: 100;
  padding: 24px 16px;
  transform: translateZ(0);
  transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1), min-width 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform var(--dur-norm) var(--ease-out-soft);
  will-change: width, min-width, transform;
  box-sizing: border-box;
}

.brand-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border-color);
  margin-bottom: 20px;
  width: 100%;
  box-sizing: border-box;
}

.brand-info {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1 1 auto;
  min-width: 0;
  overflow: visible;
  white-space: nowrap;
}

.sidebar-toggle-btn {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-sm);
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all var(--dur-fast) var(--ease-spring);
  flex-shrink: 0;
}
.sidebar-toggle-btn:hover {
  background: var(--bg-surface-elevated);
  color: var(--accent);
  border-color: var(--accent-border);
  transform: scale(1.08);
}
.sidebar-toggle-btn:active {
  transform: scale(0.92);
}

/* Transition properties for smooth collapse */
.brand-title,
.nav-label,
.sidebar-footer-text {
  transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  white-space: nowrap;
  display: inline-block;
}

/* Collapsing animation state (fading out before detachment) */
.app-sidebar.collapsing .brand-title,
.app-sidebar.collapsing .nav-label,
.app-sidebar.collapsing .sidebar-footer-text {
  opacity: 0;
  transform: translateX(-10px);
  pointer-events: none;
}

/* Initial enter state when reattached during expansion */
.sidebar-label-enter {
  opacity: 0 !important;
  transform: translateX(-10px) !important;
}

/* Collapsed Icon-Only Sidebar */
.app-sidebar.collapsed {
  width: 72px !important;
  min-width: 72px !important;
  padding: 24px 12px;
}

.app-sidebar.collapsed .brand-header {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding-bottom: 16px;
}

.app-sidebar.collapsed .brand-info {
  justify-content: center;
  width: 100%;
  flex: 0 0 auto;
}

.app-sidebar.collapsed .sidebar-toggle-btn {
  transform: rotate(180deg);
}
.app-sidebar.collapsed .sidebar-toggle-btn:hover {
  transform: rotate(180deg) scale(1.08);
}

.app-sidebar.collapsed .nav-item button {
  justify-content: center;
  padding: 12px;
  gap: 0;
  position: relative;
}

.app-sidebar.collapsed .nav-badge {
  position: absolute;
  top: 4px;
  right: 4px;
  padding: 2px 5px;
  font-size: 0.65rem;
}

.app-sidebar.collapsed .sidebar-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-top: 12px;
}

.app-sidebar.collapsed .sidebar-footer #btn-pwa-install {
  width: 44px;
  height: 44px;
  padding: 0;
  justify-content: center;
  border-radius: var(--radius-md);
  position: relative;
}

/* Tooltip on Hover in Collapsed State */
.app-sidebar.collapsed .nav-item button[data-tooltip],
.app-sidebar.collapsed #btn-pwa-install[data-tooltip] {
  position: relative;
}

.app-sidebar.collapsed .nav-item button[data-tooltip]::after,
.app-sidebar.collapsed #btn-pwa-install[data-tooltip]::after {
  content: attr(data-tooltip);
  position: absolute;
  left: calc(100% + 14px);
  top: 50%;
  transform: translateY(-50%) translateX(-6px);
  background: rgba(18, 19, 26, 0.96);
  color: #f3f0fa;
  font-size: 0.82rem;
  font-weight: 500;
  padding: 7px 13px;
  border-radius: 8px;
  border: 1px solid rgba(167, 139, 250, 0.35);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55), 0 0 12px rgba(167, 139, 250, 0.2);
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.18s cubic-bezier(0.16, 1, 0.3, 1), transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 9999;
}

.app-sidebar.collapsed .nav-item button[data-tooltip]::before,
.app-sidebar.collapsed #btn-pwa-install[data-tooltip]::before {
  content: "";
  position: absolute;
  left: calc(100% + 8px);
  top: 50%;
  transform: translateY(-50%) translateX(-6px);
  border-width: 5px 6px 5px 0;
  border-style: solid;
  border-color: transparent rgba(167, 139, 250, 0.35) transparent transparent;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.18s cubic-bezier(0.16, 1, 0.3, 1), transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 10000;
}

.app-sidebar.collapsed .nav-item button[data-tooltip]:hover::after,
.app-sidebar.collapsed .nav-item button[data-tooltip]:hover::before,
.app-sidebar.collapsed #btn-pwa-install[data-tooltip]:hover::after,
.app-sidebar.collapsed #btn-pwa-install[data-tooltip]:hover::before {
  opacity: 1;
  visibility: visible;
  transform: translateY(-50%) translateX(0);
}

.brand-icon {
  width: 38px; height: 38px;
  border-radius: 12px;
  box-shadow: 0 4px 14px var(--accent-glow);
  transition: transform var(--dur-norm) var(--ease-spring);
  object-fit: cover !important;
  object-position: center !important;
  flex-shrink: 0 !important;
}
.brand-icon:hover { transform: scale(1.1) rotate(-4deg); }

.topbar-brand-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 2px solid var(--accent);
  box-shadow: 0 2px 10px var(--accent-glow);
  object-fit: cover !important;
  object-position: center !important;
  transition: transform var(--dur-norm) var(--ease-spring);
  flex-shrink: 0 !important;
  cursor: pointer;
  display: inline-block;
}
.topbar-brand-avatar:hover {
  transform: scale(1.1) rotate(5deg);
}

.avatar-img,
.user-avatar,
.mascot-avatar {
  object-fit: cover !important;
  object-position: center !important;
}

.brand-title {
  font-family: var(--font-pixel);
  font-size: 1.18rem;
  font-weight: 700;
  background: var(--brand-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 0.01em;
  white-space: nowrap !important;
  overflow: visible !important;
  text-overflow: clip !important;
  flex: 1 1 auto;
  min-width: 0;
  line-height: 1.2;
}

.nav-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}

.nav-item button {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: var(--radius-md);
  border: 1px solid transparent;
  background: transparent;
  color: var(--text-secondary);
  font-size: 0.95rem;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--dur-fast) var(--ease-out-soft);
  text-align: left;
}
.nav-item button:hover {
  background-color: var(--bg-surface-elevated);
  color: var(--text-primary);
  transform: translateX(3px);
  will-change: transform;
}
.nav-item button:active {
  transform: translateX(3px) scale(0.97);
}
.nav-item.active button {
  background: var(--brand-gradient-subtle);
  border-color: var(--accent-border);
  color: var(--accent);
  font-weight: 600;
}

.nav-badge {
  margin-left: auto;
  font-size: 0.72rem;
  padding: 2px 8px;
  border-radius: var(--radius-full);
  background: var(--accent);
  color: #fff;
  font-weight: 700;
}

.sidebar-footer {
  padding-top: 16px;
  border-top: 1px solid var(--border-color);
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* ========== TOPBAR — 2nd allowed backdrop-filter ========== */
.app-main {
  flex: 1;
  margin-left: var(--sidebar-width);
  width: calc(100% - var(--sidebar-width));
  max-width: calc(100% - var(--sidebar-width));
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 80px;
  background: transparent;
  overflow-x: hidden;
  box-sizing: border-box;
  transition: margin-left 0.3s cubic-bezier(0.16, 1, 0.3, 1), width 0.3s cubic-bezier(0.16, 1, 0.3, 1), max-width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.app-main.sidebar-collapsed {
  margin-left: 72px;
  width: calc(100% - 72px);
  max-width: calc(100% - 72px);
}

.app-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 28px;
  background: rgba(18, 19, 26, 0.85);
  border-bottom: 1px solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 100;
  transform: translateZ(0);
  gap: 16px;
  box-sizing: border-box;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1 1 auto;
  min-width: 0;
}
.topbar-title {
  font-family: var(--font-pixel);
  font-size: 1.25rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0;
  white-space: nowrap;
  flex: 1 1 auto;
  min-width: 0;
  overflow: visible;
  line-height: 1.3;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-shrink: 0;
}

/* Streak Counter */
.streak-chip {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  background: linear-gradient(135deg, rgba(212,168,85,0.14), rgba(226,125,139,0.08));
  border: 1px solid rgba(212,168,85,0.30);
  border-radius: var(--radius-full);
  font-size: 0.92rem;
  font-weight: 700;
  color: var(--streak-color);
}

/* Icon buttons */
.icon-btn {
  width: 40px; height: 40px;
  display: grid;
  place-items: center;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-color);
  background: var(--bg-surface);
  color: var(--text-secondary);
  cursor: pointer;
  transition: all var(--dur-fast) var(--ease-spring);
}
.icon-btn:hover {
  background: var(--bg-surface-elevated);
  color: var(--text-primary);
  border-color: var(--border-focus);
  transform: scale(1.06);
  will-change: transform;
}
.icon-btn:active { transform: scale(0.92); }

/* ========== CONTENT ========== */
.content-wrapper {
  max-width: 1380px;
  width: 100%;
  margin: 0 auto;
  padding: 28px 24px;
  background: transparent;
  box-sizing: border-box;
  overflow-x: clip;
}

@media (min-width: 1920px) {
  .content-wrapper {
    max-width: 1560px;
    padding: 32px 32px;
  }
}

/* Ultrawide safety guard: Cap maximum expansion to prevent infinite stretching on 2560px+ */
@media (min-width: 2400px) {
  .content-wrapper {
    max-width: 1680px;
  }
}

/* View transitions — Clean high-FPS fade & soft glide without nested bounce jank */
.view-section {
  display: none;
  background: transparent;
}
.view-section.active {
  display: block;
  animation: viewFadeIn 180ms ease-out forwards;
}

@keyframes viewFadeIn {
  0%   { opacity: 0; }
  100% { opacity: 1; }
}

/* ========== TAB WAVE CURTAIN TRANSITION (< 450ms) ========== */
.tab-wave-curtain {
  position: fixed;
  inset: 0;
  z-index: 9999;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  overflow: hidden;
}

.tab-wave-curtain.animating {
  opacity: 1;
  visibility: visible;
}

.wave-sweep-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 160%;
  height: 100%;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(167, 139, 250, 0.12) 25%, 
    rgba(192, 132, 252, 0.32) 50%, 
    rgba(167, 139, 250, 0.12) 75%, 
    transparent 100%);
  transform: translate3d(-100%, 0, 0);
}

.tab-wave-curtain.animating .wave-sweep-layer {
  will-change: transform;
  animation: waveSweepAcross 380ms cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

@keyframes waveSweepAcross {
  0% {
    transform: translate3d(-100%, 0, 0);
  }
  100% {
    transform: translate3d(100%, 0, 0);
  }
}

/* ========== HERO CARD ========== */
.hero-card {
  background: var(--glass-tint);
  border: 1px solid var(--glass-border);
  border-top-color: var(--glass-highlight);
  border-radius: var(--radius-card);
  padding: 44px 32px 32px 32px;
  margin-bottom: 28px;
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 1px 0 var(--glass-highlight), var(--shadow-md);
  transition: transform var(--dur-norm) var(--ease-spring), box-shadow var(--dur-norm) var(--ease-out-soft), border-color var(--dur-norm) ease;
  contain: layout style;
  transform: translateZ(0);
}
.hero-card:hover {
  transform: translateY(-2px) translateZ(0);
  border-color: var(--accent-border);
  box-shadow: inset 0 1px 0 var(--glass-highlight), var(--card-hover-glow);
}
.hero-card::before {
  content: '';
  position: absolute;
  top: -50%; right: -20%;
  width: 340px; height: 340px;
  background: radial-gradient(circle, var(--accent-glow), transparent 60%);
  border-radius: 50%;
  pointer-events: none;
  transform: translateZ(0);
}

/* Scrim overlay protecting headline contrast on all wallpapers */
.hero-heading-scrim {
  position: relative;
  padding: 24px 28px;
  margin: 0 0 18px 0;
  border-radius: 20px;
  background: radial-gradient(ellipse at 25% 45%, rgba(10, 8, 22, 0.88) 0%, rgba(10, 8, 22, 0.62) 65%, transparent 100%);
  border: 1px solid rgba(255, 255, 255, 0.04);
  box-shadow: 0 14px 40px -10px rgba(0, 0, 0, 0.75);
  transform: translateZ(0);
}

.hero-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 32px;
  width: 100%;
}

