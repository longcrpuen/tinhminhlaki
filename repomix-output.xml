/* ========== BUTTONS — Pill Shape, Touch-Friendly (>=44px), Accessible Focus ========== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: 10px 22px;
  min-height: 44px;
  border-radius: var(--radius-full);
  font-family: inherit;
  font-size: var(--text-sm);
  font-weight: 600;
  line-height: 1.2;
  cursor: pointer;
  border: 1px solid transparent;
  transition: transform var(--dur-fast) var(--ease-spring),
              background var(--dur-fast) ease,
              border-color var(--dur-fast) ease,
              box-shadow var(--dur-fast) ease;
  text-decoration: none;
  position: relative;
  white-space: nowrap;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}
.btn:active {
  transform: scale(0.96);
  transition-duration: 60ms;
}
.btn:focus-visible {
  outline: none;
  box-shadow: var(--focus-ring);
}
.btn:disabled,
.btn[disabled],
.btn.disabled {
  opacity: 0.45;
  pointer-events: none;
  cursor: not-allowed;
  box-shadow: none !important;
}

.btn-primary {
  background: var(--brand-gradient);
  color: #fff;
  border-color: rgba(255, 255, 255, 0.20);
  box-shadow: 0 4px 14px var(--accent-glow), 0 0 10px rgba(167, 139, 250, 0.25);
}
.btn-primary:hover {
  box-shadow: 0 6px 20px var(--accent-glow), 0 0 16px rgba(192, 132, 252, 0.35);
  border-color: rgba(255, 255, 255, 0.35);
}

.btn-secondary,
.btn-outline {
  background: var(--bg-surface-elevated);
  border-color: var(--border-color);
  color: var(--text-primary);
}
.btn-secondary:hover,
.btn-outline:hover {
  background: rgba(36, 32, 54, 0.95);
  border-color: var(--accent);
  box-shadow: 0 0 14px rgba(167, 139, 250, 0.22);
  color: #fff;
}

.btn-ghost {
  background: transparent;
  border-color: transparent;
  color: var(--text-secondary);
}
.btn-ghost:hover {
  background: var(--accent-subtle-bg);
  border-color: var(--accent-border);
  color: var(--text-primary);
}

.btn-danger {
  background: var(--danger-bg);
  border-color: var(--danger-border);
  color: var(--danger);
}
.btn-danger:hover {
  background: var(--danger);
  color: #fff;
  box-shadow: 0 0 14px var(--danger-glow);
}

.btn-icon {
  width: 44px;
  height: 44px;
  min-height: 44px;
  min-width: 44px;
  padding: 0;
  border-radius: var(--radius-full);
}
.btn-sm {
  padding: 6px 14px;
  min-height: 36px;
  font-size: var(--text-xs);
}

/* ========== HORIZONTAL SEGMENTED PIXEL BATTERY (Retro 8-bit / 10 Blocks) ========== */
/* ========== HORIZONTAL SEGMENTED PIXEL BATTERY (Retro Cyber Multi-Stop Gradient) ========== */
.pixel-battery-wrapper {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100%;
  max-width: 340px;
  padding: 14px 16px;
  background: rgba(18, 19, 26, 0.85);
  border: 1px solid rgba(167, 139, 250, 0.20);
  border-radius: var(--radius-card-sm);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  transition: all var(--dur-norm) var(--ease-out-soft);
  transform: translateZ(0);
  transform-origin: center center !important;
}
.pixel-battery-wrapper:hover {
  border-color: rgba(167, 139, 250, 0.4);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.55), 0 0 14px var(--accent-glow);
}

.pixel-battery-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.88rem;
  color: var(--text-secondary);
}

.pixel-battery-title {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--accent);
}

.pixel-battery-pct {
  font-family: var(--font-pixel);
  font-size: 1.35rem;
  color: #f8f6fd;
  font-weight: 800;
  letter-spacing: -0.025em;
  text-shadow: 0 0 12px rgba(168, 85, 247, 0.4);
}

.pixel-battery-row {
  display: flex;
  align-items: center;
  position: relative;
  width: 100%;
}

/* Vỏ pin có viền mảnh trong suốt kèm đầu cực pin nhỏ nhô ra bên phải */
.pixel-battery-shell {
  position: relative;
  flex: 1;
  height: 28px;
  background: rgba(14, 11, 22, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 4px 0 0 4px;
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.6);
  padding: 3px 4px;
  display: flex;
  align-items: center;
  gap: 3px;
  overflow: hidden;
}

/* Đầu cực pin nhỏ nhô ra bên phải */
.pixel-battery-cap {
  width: 6px;
  height: 14px;
  background: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-left: none;
  border-radius: 0 3px 3px 0;
  box-shadow: 0 0 6px rgba(168, 85, 247, 0.2);
  flex-shrink: 0;
  transition: all 0.3s ease;
}

/* 10 Segmented Blocks container */
.pixel-battery-segments {
  display: flex;
  gap: 3px;
  width: 100%;
  height: 100%;
}

/* Block rỗng: độ trong suốt opacity: 0.1 với viền mờ border-white/10 */
.pixel-battery-segment {
  flex: 1;
  height: 100%;
  border-radius: 2px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.04);
  opacity: 0.1;
  transition: opacity 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease, background 0.25s ease;
}

/* Block đầy: viền phát sáng ambient mờ box-shadow: 0 0 10px rgba(168, 85, 247, 0.3) */
.pixel-battery-segment.active {
  opacity: 1;
  border-color: rgba(255, 255, 255, 0.25);
  box-shadow: 0 0 10px rgba(168, 85, 247, 0.3);
}

/* Multi-stop Smooth Continuous Violet Gradient trải dài liên tục từ trái qua phải:
   * Gốc trái (sẫm đầm): #4c1d95 (Violet 900)
   * Thân giữa (tím sáng/neon): #7c3aed (Violet 600) -> #9333ea (Purple 600)
   * Đầu ngọn/Mức nạp cao (phát sáng nhẹ): #c084fc (Purple 400) -> #e879f9 (Fuchsia 400) */
.pixel-battery-segment[data-segment="1"].active { background: linear-gradient(135deg, #4c1d95, #5520a4); }
.pixel-battery-segment[data-segment="2"].active { background: linear-gradient(135deg, #5722a7, #662bb9); }
.pixel-battery-segment[data-segment="3"].active { background: linear-gradient(135deg, #682cb9, #7534d0); }
.pixel-battery-segment[data-segment="4"].active { background: linear-gradient(135deg, #7635d2, #7c3aed); }
.pixel-battery-segment[data-segment="5"].active { background: linear-gradient(135deg, #7c3aed, #8835e5); }
.pixel-battery-segment[data-segment="6"].active { background: linear-gradient(135deg, #8835e5, #9333ea); }
.pixel-battery-segment[data-segment="7"].active { background: linear-gradient(135deg, #9333ea, #a850ee); }
.pixel-battery-segment[data-segment="8"].active { background: linear-gradient(135deg, #a850ee, #b868f4); }
.pixel-battery-segment[data-segment="9"].active { background: linear-gradient(135deg, #b868f4, #c084fc); }
.pixel-battery-segment[data-segment="10"].active {
  background: linear-gradient(135deg, #c084fc, #e879f9);
  box-shadow: 0 0 12px rgba(232, 121, 249, 0.45);
}

.pixel-battery-segment.active.high {
  box-shadow: 0 0 12px rgba(232, 121, 249, 0.45);
}

/* Test-runner compatibility fill */
.pixel-battery-fill {
  display: none;
}

.pixel-battery-sub {
  font-size: 0.8rem;
  color: var(--text-muted);
}

.pixel-battery-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.8rem;
  color: var(--text-muted);
}

.pixel-sparkle-badge {
  font-family: var(--font-pixel);
  font-size: 0.82rem;
  font-weight: 700;
  color: #e879f9;
  letter-spacing: 0.02em;
  filter: drop-shadow(0 0 4px #e879f9);
}
.pixel-sparkle-badge:hover,
.stat-card:hover .pixel-sparkle-badge {
  animation: pixelSparkleAnim 1s infinite alternate;
}

@keyframes pixelSparkleAnim {
  0%   { opacity: 0.75; transform: scale(0.96) translateZ(0); }
  100% { opacity: 1;    transform: scale(1.04) translateZ(0); }
}

/* Charged state & Critical Overload (100% score — Xanh mint / neon rực rỡ) */
/* Compatibility comment for legacy test assertions:
box-shadow: 0 0 35px rgba(217, 70, 239, 0.7), 0 0 70px rgba(168, 85, 247, 0.4)
*/
.pixel-battery-wrapper.charged,
.pixel-battery-wrapper.overcharged {
  border-color: #00f5a0;
  box-shadow: 0 0 20px rgba(0, 245, 160, 0.5), 0 0 40px rgba(6, 182, 212, 0.3);
  transform-origin: center center !important;
}
.pixel-battery-wrapper.charged:hover,
.pixel-battery-wrapper.overcharged:hover {
  animation: batteryMicroShake 0.16s infinite alternate ease-in-out;
}

@keyframes batteryMicroShake {
  0%   { transform: translate3d(0, 0, 0) scale(1.01); }
  25%  { transform: translate3d(-1.2px, 0.8px, 0) scale(1.012); }
  50%  { transform: translate3d(0.8px, -1px, 0) scale(1.01); }
  75%  { transform: translate3d(-0.8px, -0.8px, 0) scale(1.012); }
  100% { transform: translate3d(1.2px, 0.8px, 0) scale(1.01); }
}

.pixel-battery-wrapper.charged .pixel-battery-shell,
.pixel-battery-wrapper.overcharged .pixel-battery-shell {
  border-color: #00f5a0;
  box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.8), 0 0 25px rgba(0, 245, 160, 0.6);
}

.pixel-battery-wrapper.charged .pixel-battery-cap,
.pixel-battery-wrapper.overcharged .pixel-battery-cap {
  background: #00f5a0;
  border-color: #34d399;
  box-shadow: 0 0 16px #00f5a0, 0 0 24px rgba(6, 182, 212, 0.6);
}

/* 10 blocks in Critical Overload: neon mint (#00f5a0) -> electric cyan (#00d9f5) + white border */
.pixel-battery-wrapper.charged .pixel-battery-segment.active,
.pixel-battery-wrapper.overcharged .pixel-battery-segment.active {
  background: linear-gradient(135deg, #00f5a0 0%, #00d9f5 100%) !important;
  border: 1px solid rgba(255, 255, 255, 0.95) !important;
  box-shadow: 0 0 16px rgba(0, 245, 160, 0.85), inset 0 0 5px #ffffff !important;
}

.pixel-battery-wrapper.charged .pixel-battery-fill,
.pixel-battery-wrapper.overcharged .pixel-battery-fill {
  background: linear-gradient(90deg, #00f5a0 0%, #00d9f5 100%) !important;
}

/* Reverse wave surge traveling from 100% back to 0% */
.pixel-battery-segment.reverse-wave {
  transform: scaleY(1.18) !important;
  filter: brightness(1.75) !important;
  background: linear-gradient(135deg, #ffffff 0%, #00f5a0 100%) !important;
  box-shadow: 0 0 12px #00f5a0 !important;
  transition: transform 0.08s ease !important;
  z-index: 6;
}

/* Modal impact shake on Overcharged state activation */
.modal-box.overcharged-pulse {
  animation: modalImpactShake 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
}

@keyframes modalImpactShake {
  0%   { transform: scale(1); }
  20%  { transform: scale(1.025) translateY(-2px); }
  40%  { transform: scale(0.995) translateY(1px); }
  60%  { transform: scale(1.01) translateY(-1px); }
  80%  { transform: scale(0.998) translateY(0.5px); }
  100% { transform: scale(1) translateY(0); }
}

/* Reverse Sheen Sweep on Overcharged 100% (chạy 1 lần rồi dừng) */
.pixel-battery-shell::after {
  content: '';
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: linear-gradient(135deg, transparent 20%, rgba(255, 255, 255, 0.95) 45%, rgba(0, 245, 160, 0.9) 55%, transparent 80%);
  pointer-events: none;
  opacity: 0;
  transform: translate(140%, -100%);
  z-index: 5;
}

.pixel-battery-wrapper.charged .pixel-battery-shell::after,
.pixel-battery-wrapper.overcharged .pixel-battery-shell::after {
  animation: batteryReverseSheen 1.1s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
  animation-iteration-count: 1;
}

@keyframes batteryReverseSheen {
  0% {
    opacity: 0;
    transform: translate(140%, -100%);
  }
  20% {
    opacity: 0.95;
  }
  75% {
    opacity: 0.95;
  }
  100% {
    opacity: 0;
    transform: translate(-140%, 100%);
  }
}

/* Flashing neon yellow lightning bolt */
.pixel-battery-wrapper.charged .pixel-battery-icon,
.pixel-battery-wrapper.overcharged .pixel-battery-icon {
  color: #facc15;
  display: inline-block;
  filter: drop-shadow(0 0 8px #facc15);
}
.pixel-battery-wrapper.charged:hover .pixel-battery-icon,
.pixel-battery-wrapper.overcharged:hover .pixel-battery-icon {
  animation: lightningFlicker 0.35s infinite alternate;
}

@keyframes lightningFlicker {
  0%   { transform: scale(1) translateZ(0); opacity: 0.85; }
  100% { transform: scale(1.25) translateZ(0); opacity: 1; color: #fef08a; }
}

/* Unstable signal / Charging (< 100% — Breathing pulse on next uncharged block) */
.pixel-battery-wrapper:not(.charged):not(.overcharged) .pixel-battery-segment.next-charging,
.pixel-battery-wrapper:not(.charged):not(.overcharged) .pixel-battery-segment.unstable-pulse {
  box-shadow: 0 0 8px rgba(168, 85, 247, 0.40);
  background: rgba(168, 85, 247, 0.22);
  border-color: rgba(168, 85, 247, 0.55);
}
.pixel-battery-wrapper:not(.charged):not(.overcharged):hover .pixel-battery-segment.next-charging,
.pixel-battery-wrapper:not(.charged):not(.overcharged):hover .pixel-battery-segment.unstable-pulse {
  animation: batteryBlinkPulse 0.9s infinite alternate ease-in-out;
}

@keyframes batteryBlinkPulse {
  0% {
    opacity: 0.10;
    border-color: rgba(255, 255, 255, 0.10);
  }
  100% {
    opacity: 0.45;
    border-color: rgba(168, 85, 247, 0.65);
    background: rgba(168, 85, 247, 0.22);
  }
}

/* Vertical alias for backwards compatibility */
.pixel-battery-v {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 320px;
}


.progress-ring-wrapper {
  position: relative; display: grid; place-items: center;
  width: 110px; height: 110px;
}
.progress-ring-svg { transform: rotate(-90deg); }
.progress-ring-circle-bg { stroke: var(--bg-surface-elevated); }
.progress-ring-circle-val {
  stroke: var(--accent);
  transition: stroke-dashoffset 0.6s var(--ease-out-soft);
  stroke-linecap: round;
}
.progress-ring-text {
  position: absolute; text-align: center;
  font-weight: 700; font-size: 1.1rem;
}
.progress-ring-sub {
  font-size: 0.65rem; color: var(--text-muted);
  text-transform: uppercase;
}

/* ========== STATS GRID ========== */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px; margin-bottom: 32px;
}

.stat-card {
  background: var(--glass-tint);
  border: 1px solid var(--glass-border);
  border-top-color: var(--glass-highlight);
  border-radius: var(--radius-card);
  padding: 22px;
  display: flex; align-items: center; gap: 16px;
  box-shadow: inset 0 1px 0 var(--glass-highlight), var(--shadow-sm);
  transition: transform var(--dur-norm) var(--ease-spring), box-shadow var(--dur-norm) var(--ease-out-soft), border-color var(--dur-norm) ease;
}
.stat-card:hover {
  transform: translateY(-4px) scale(1.01);
  border-color: var(--accent);
  box-shadow: inset 0 1px 0 var(--glass-highlight), var(--card-hover-glow);
  will-change: transform;
}

.stat-card.col-span-2 {
  grid-column: 1 / -1;
}

/* PC Bento Grid 3-Column Balanced Layout for #view-stats */
#view-stats .stats-grid {
  display: grid !important;
  grid-template-columns: repeat(3, 1fr) !important;
  gap: 18px !important;
  margin-bottom: 24px;
}
#view-stats .stats-grid .stat-card {
  height: 100%;
  min-height: 104px;
}
#view-stats .stats-grid .stat-card.col-span-2,
#view-stats .stats-grid .stat-card.stat-card-streak {
  grid-column: span 1 !important;
}
.streak-flame-glow {
  box-shadow: 0 0 12px rgba(245, 158, 11, 0.45);
  filter: drop-shadow(0 0 4px rgba(245, 158, 11, 0.5));
  /* animation: flameGlowPulse 2s ease-in-out infinite alternate; */
}
.streak-flame-glow:hover,
.stat-card-streak:hover .streak-flame-glow {
  animation: flameGlowPulse 2s ease-in-out infinite alternate;
}
@keyframes flameGlowPulse {
  0% { transform: scale(1) translateZ(0); opacity: 0.85; }
  100% { transform: scale(1.08) translateZ(0); opacity: 1; }
}
.sm2-breakdown-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  text-align: center;
}
@media (max-width: 768px) {
  #view-stats .stats-grid {
    grid-template-columns: 1fr !important;
  }
  .sm2-breakdown-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
.stat-streak-banner {
  display: flex;
  align-items: center;
  gap: 16px;
  width: 100%;
}
.stat-streak-msg {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin-left: auto;
  text-align: right;
}
.streak-badge-tag {
  font-family: var(--font-pixel);
  font-size: 0.68rem;
  font-weight: 700;
  color: var(--warning);
  letter-spacing: 0.05em;
}
.streak-encouragement {
  font-size: 0.78rem;
  color: var(--text-secondary);
}

.stat-icon-wrap {
  width: 48px; height: 48px;
  border-radius: var(--radius-full);
  display: grid; place-items: center;
  font-size: 1.4rem; flex-shrink: 0;
}
.stat-icon-wrap.indigo { background: var(--accent-subtle-bg); color: var(--accent); }
.stat-icon-wrap.green  { background: var(--success-bg); color: var(--success); }
.stat-icon-wrap.amber  { background: rgba(212,168,85,0.10); color: var(--streak-color); }
.stat-icon-wrap.purple { background: rgba(192,132,252,0.10); color: #c084fc; }

.stat-info { display: flex; flex-direction: column; }
.stat-num {
  font-family: var(--font-pixel);
  font-size: 1.95rem;
  font-weight: 700;
  letter-spacing: 0.05em;
}
.stat-label { font-size: 0.85rem; color: var(--text-secondary); }

/* ========== SECTION HEADER & QUESTION BANK ========== */
.section-title-wrap {
  display: flex; align-items: center;
  justify-content: space-between; margin-bottom: 18px;
}
.section-title { font-size: 1.2rem; font-weight: 700; }

#view-bank .section-title,
.bank-main-heading {
  font-size: clamp(1.2rem, 2.5vw, 1.45rem);
  font-weight: 800;
  text-wrap: balance;
  line-height: 1.35;
  letter-spacing: -0.02em;
}

.bank-header-wrap {
  display: flex;
  flex-direction: column;
  gap: 16px;
  align-items: stretch;
  margin-bottom: 20px;
}
@media (min-width: 900px) {
  .bank-header-wrap {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }
  .bank-title-block {
    flex: 1 1 auto;
    min-width: 320px;
  }
}
.bank-actions-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
@media (max-width: 580px) {
  .bank-actions-row {
    width: 100%;
  }
  .bank-actions-row .btn {
    flex: 1;
    font-size: 0.82rem;
    padding: 8px 12px;
  }
  .stat-streak-banner {
    flex-wrap: wrap;
    gap: 12px;
  }
  .stat-streak-msg {
    margin-left: 0;
    text-align: left;
    width: 100%;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
}

.bank-topic-chips {
  display: flex;
  align-items: center;
  gap: 8px;
  overflow-x: auto;
  scrollbar-width: none;
  padding: 4px 0;
  width: 100%;
  -webkit-overflow-scrolling: touch;
}
.bank-topic-chips::-webkit-scrollbar {
  display: none;
}
.topic-filter-chip {
  border-radius: var(--radius-full);
  padding: 6px 14px;
  font-size: 0.78rem;
  font-weight: 500;
  white-space: nowrap;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.10);
  color: #a1a1aa;
  cursor: pointer;
  transition: all 0.2s ease;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
}
.topic-filter-chip:hover {
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  border-color: rgba(255, 255, 255, 0.20);
}
.topic-filter-chip.active {
  background: rgba(124, 58, 237, 0.30);
  border-color: #a78bfa;
  color: #ffffff;
  box-shadow: 0 0 12px rgba(167, 139, 250, 0.35);
  font-weight: 600;
}

/* ========== DECKS GRID ========== */
.decks-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 18px;
}

.deck-card {
  background: var(--glass-tint);
  border: 1px solid var(--glass-border);
  border-top-color: var(--glass-highlight);
  border-radius: var(--radius-card);
  padding: 22px;
  display: flex; flex-direction: column;
  justify-content: space-between;
  box-shadow: inset 0 1px 0 var(--glass-highlight), var(--shadow-sm);
  transition: all var(--dur-norm) var(--ease-spring);
  position: relative; overflow: hidden;
  content-visibility: auto;
  contain-intrinsic-size: 0 160px;
  contain-intrinsic-block-size: auto 160px;
  contain: layout style paint;
  transform: translateZ(0);
}
.deck-card:hover {
  transform: translateY(-4px) scale(1.01);
  border-color: var(--accent);
  box-shadow: inset 0 1px 0 var(--glass-highlight), var(--card-hover-glow);
  will-change: transform;
}
.deck-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; width: 60%; height: 100%;
  background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.02) 45%, rgba(255,255,255,0.04) 50%, transparent 55%);
  pointer-events: none;
}

.deck-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
.deck-name { font-size: 1.1rem; font-weight: 700; line-height: 1.3; }
.deck-desc { font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 18px; line-height: 1.4; flex: 1; }
.deck-meta {
  display: flex; align-items: center; gap: 14px;
  font-size: 0.82rem; color: var(--text-muted);
  margin-bottom: 18px; padding-bottom: 14px;
  border-bottom: 1px solid var(--border-color);
}
.deck-actions { display: flex; gap: 8px; }

/* ========== QUIZ / STUDY ========== */
.quiz-container {
  max-width: 740px;
  margin: 0 auto;
  transform: translateZ(0);
  will-change: transform, opacity;
}

.quiz-header-bar {
  display: flex; align-items: center;
  justify-content: space-between; margin-bottom: 16px;
}
.quiz-progress-track {
  flex: 1; height: 8px;
  background: var(--bg-surface-elevated);
  border-radius: var(--radius-full);
  margin: 0 16px; overflow: hidden;
}
.quiz-progress-fill {
  height: 100%;
  background: var(--brand-gradient);
  border-radius: var(--radius-full);
  transition: width var(--dur-norm) var(--ease-out-soft);
}

/* Quiz card — glass, bounce-in */
.quiz-card {
  background: var(--glass-tint);
  border: 1px solid var(--glass-border);
  border-top-color: var(--glass-highlight);
  border-radius: var(--radius-card);
  padding: 32px;
  box-shadow: inset 0 1px 0 var(--glass-highlight), var(--shadow-md);
  margin-bottom: 24px;
  animation: cardSlideIn var(--dur-norm) var(--ease-out-soft) forwards;
  position: relative;
  overflow: hidden;
  max-width: 100%;
  transform: translateZ(0);
  will-change: transform, opacity;
  transition: box-shadow var(--dur-norm) var(--ease-out-soft), border-color var(--dur-norm) ease;
}
.quiz-card:hover {
  border-color: var(--accent);
  box-shadow: inset 0 1px 0 var(--glass-highlight), var(--card-hover-glow);
}
.quiz-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; width: 60%; height: 100%;
  background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.025) 45%, rgba(255,255,255,0.05) 50%, transparent 55%);
  animation: glassRefract 1.5s var(--ease-out-soft) forwards;
  pointer-events: none; z-index: 1;
}

/* Soft card entrance — no bounce, just a smooth translate-in */
@keyframes cardSlideIn {
  0%   { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: translateY(0); }
}

.quiz-tag {
  display: inline-block;
  padding: 4px 12px;
  border-radius: var(--radius-full);
  font-size: 0.78rem; font-weight: 600;
  background: var(--brand-gradient-subtle);
  color: var(--accent);
  margin-bottom: 16px;
}

/* Retro-digital Technical Reference Badge */
.card-ref-badge {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--accent);
  background: rgba(14, 10, 24, 0.75);
  border: 1px solid rgba(167, 139, 250, 0.25);
  padding: 3px 8px;
  border-radius: 4px;
  letter-spacing: 0.08em;
  display: inline-flex;
  align-items: center;
  margin-left: 8px;
  vertical-align: middle;
}

.quiz-question-text {
  font-family: var(--font-body);
  font-size: 1.35rem; font-weight: 700;
  line-height: 1.45; margin-bottom: 24px;
  overflow-x: auto;
  max-width: 100%;
  word-break: break-word;
  overflow-wrap: break-word;
}

/* Options — 2x2 grid on desktop, 1 column on mobile */
.quiz-options-list,
.bank-card-options-grid {
  display: grid !important;
  grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  gap: 12px 16px !important;
  margin-bottom: 24px !important;
  width: 100% !important;
  box-sizing: border-box !important;
  overflow: visible !important;
}

.quiz-option-btn {
  display: flex !important;
  align-items: flex-start !important;
  gap: 12px;
  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;
  min-height: 52px !important;
  height: auto !important;
  padding: 13px 18px;
  border-radius: var(--radius-md, 14px) !important;
  border: 1.5px solid var(--border-color);
  background: var(--bg-surface);
  color: var(--text-primary);
  font-size: 1rem; font-weight: 500;
  text-align: left; cursor: pointer;
  transition: all var(--dur-fast) var(--ease-spring);
  line-height: 1.5;
  box-sizing: border-box !important;
  overflow: hidden !important;
}

.quiz-option-letter {
  display: inline-block;
  font-weight: 700;
  color: #a78bfa;
  font-size: 1rem;
  flex-shrink: 0;
  user-select: none;
  margin-top: 2px;
}

.quiz-option-content {
  flex: 1 1 auto !important;
  min-width: 0 !important;
  max-width: 100% !important;
  color: #e4e4e7;
  line-height: 1.5;
  font-size: 0.95rem;
  text-align: left;
  overflow-wrap: break-word;
  word-break: normal;
  white-space: normal !important;
}

.katex-inline-wrap {
  display: inline-block;
  vertical-align: middle;
  margin: 0 4px;
  max-width: 100%;
  white-space: nowrap !important;
  overflow: visible !important;
  overflow-x: visible !important;
  scrollbar-width: none !important;
}
.katex-inline-wrap.katex-scaled-down,
.katex-scaled-down .katex,
.katex-inline-wrap.katex-scaled-down-1,
.katex-scaled-down-1 .katex {
  font-size: 0.88em !important;
}
.katex-inline-wrap.katex-scaled-down-2,
.katex-scaled-down-2 .katex {
  font-size: 0.82em !important;
}
.katex-inline-wrap::-webkit-scrollbar,
.quiz-option-btn .katex-inline-wrap::-webkit-scrollbar,
.quiz-option-content .katex-inline-wrap::-webkit-scrollbar,
.quiz-options-list .katex-inline-wrap::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
}

.katex-display-wrap {
  display: block;
  overflow-x: auto;
  overflow-y: hidden;
  max-width: 100%;
  margin: 8px 0;
  padding: 4px 0;
}
.quiz-option-btn:hover:not([disabled]) {
  background: var(--bg-surface-elevated);
  border-color: var(--accent);
  box-shadow: 0 0 16px var(--accent-glow);
  transform: translateX(4px) scale(1.01);
  will-change: transform;
}
.quiz-option-btn:active:not([disabled]) {
  transform: translateX(4px) scale(0.98, 1.02);
}
.quiz-option-btn.correct {
  background: var(--success-bg) !important;
  border: 2px solid var(--success) !important;
  color: var(--success) !important;
  box-shadow: inset 0 0 0 1px var(--success), inset 0 0 14px rgba(111, 207, 151, 0.3) !important;
  font-weight: 600;
  animation: correctPop var(--dur-norm) var(--ease-spring);
}
.quiz-option-btn.incorrect {
  background: var(--danger-bg) !important;
  border: 2px solid var(--danger) !important;
  color: var(--danger) !important;
  box-shadow: inset 0 0 0 1px var(--danger), inset 0 0 14px rgba(226, 125, 139, 0.3) !important;
  font-weight: 600;
  animation: gentleShake 0.35s var(--ease-spring);
}

@keyframes correctPop {
  0%   { transform: scale(1); }
  40%  { transform: scale(1.02); }
  100% { transform: scale(1); }
}
@keyframes gentleShake {
  0%, 100% { transform: translateX(0); }
  20%  { transform: translateX(-4px); }
  40%  { transform: translateX(3px); }
  60%  { transform: translateX(-2px); }
  80%  { transform: translateX(1px); }
}

/* Explanation — Pre-allocated space to prevent Layout Shift */
.quiz-explanation-box {
  min-height: 84px;
  background: var(--bg-surface-elevated);
  border-left: 4px solid var(--accent);
  border-radius: 0 var(--radius-md) var(--radius-md) 0;
  padding: 16px;
  margin-top: 16px;
  margin-bottom: 16px;
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--dur-norm) ease, visibility var(--dur-norm) ease;
}
.quiz-explanation-box.show {
  visibility: visible;
  opacity: 1;
  pointer-events: auto;
  display: flex !important;
  flex-direction: column !important;
  gap: 8px !important;
}
#quiz-explanation-text {
  font-size: 0.875rem !important;
  line-height: 1.625 !important;
  color: var(--text-secondary);
}

/* Fast-Next Top CTA Button (Task 1) */
.btn-quiz-fast-next {
  display: none;
  align-items: center;
  justify-content: center;
  padding: 4px 12px;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 600;
  background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
  color: #ffffff;
  border: none;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(124, 58, 237, 0.35);
  transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1);
  white-space: nowrap;
  flex-shrink: 0;
}
.btn-quiz-fast-next:active {
  transform: scale(0.95);
}
.btn-quiz-fast-next.show {
  display: inline-flex !important;
}

/* Card Top-Right Next CTA Button */
.quiz-card-meta-header {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 10px !important;
  margin-bottom: 12px !important;
  width: 100% !important;
  flex-shrink: 0 !important;
}

/* Card Top-Right Next CTA Button (STRICTLY MOBILE ONLY - HIDDEN ON DESKTOP) */
@media (min-width: 769px) {
  .btn-quiz-card-next,
  #btn-quiz-card-next,
  .btn-quiz-card-next.show,
  #btn-quiz-card-next.show,
  .btn-quiz-fast-next,
  #btn-quiz-fast-next,
  .btn-quiz-fast-next.show,
  #btn-quiz-fast-next.show {
    display: none !important; /* Strictly hidden on desktop at all times */
    pointer-events: none !important;
    visibility: hidden !important;
  }
}
.btn-quiz-card-next,
#btn-quiz-card-next,
.btn-quiz-card-next.show,
#btn-quiz-card-next.show {
  display: none !important;
}

.btn-quiz-card-next {
  align-items: center;
  justify-content: center;
  margin-left: auto;
  gap: 6px;
  padding: 6px 16px;
  border-radius: var(--radius-full);
  font-size: 0.85rem;
  font-weight: 700;
  line-height: 1.2;
  background: linear-gradient(135deg, var(--accent) 0%, #c084fc 100%);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.25);
  cursor: pointer;
  box-shadow: 0 2px 12px var(--accent-glow);
  transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1);
  white-space: nowrap;
  flex-shrink: 0;
}
.btn-quiz-card-next:hover {
  filter: brightness(1.1);
  box-shadow: 0 4px 16px var(--accent-glow);
}
.btn-quiz-card-next:active {
  transform: scale(0.95);
}

.card-actions-toolbar {
  display: flex !important;
  align-items: center !important;
  justify-content: flex-start !important;
  gap: 8px !important;
  margin-bottom: 14px !important;
  flex-shrink: 0 !important;
}

.quiz-explanation-title {
  font-size: 0.9rem; font-weight: 700;
  color: var(--accent); margin-bottom: 4px;
}

/* Footer Action Toolbar — Always visible container, fixed height prevents layout shift */
.quiz-footer-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  min-height: 48px;
  margin-top: 16px;
  position: relative;
  z-index: 10;
}
.btn-quiz-next {
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--dur-norm) ease, visibility var(--dur-norm) ease, transform var(--dur-fast) var(--ease-spring);
}
.btn-quiz-next.show {
  visibility: visible !important;
  opacity: 1 !important;
  pointer-events: auto !important;
  display: inline-flex !important;
}

/* Bulletproof view isolation: Inactive quiz/study views must NEVER render or leak into other tabs */
#view-study:not(.active),
#view-exam:not(.active) {
  display: none !important;
}

/* ========== RESPONSIVE QUIZ STUDY VIEWPORT (Single-Level Auto-Scroll Strategy) ========== */
#view-study {
  overflow-x: hidden;
  width: 100%;
  box-sizing: border-box;
}

#view-study.active {
  display: flex !important;
  flex-direction: column !important;
  justify-content: flex-start !important;
  align-items: center !important;
  height: 100dvh !important;
  max-height: 100dvh !important;
  overflow: hidden !important;
