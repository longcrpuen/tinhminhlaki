}
.subject-group:hover {
  border-color: rgba(167, 139, 250, 0.40);
}
.subject-group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  background: rgba(26, 23, 48, 0.65);
  border-bottom: 1px solid rgba(139, 92, 246, 0.15);
